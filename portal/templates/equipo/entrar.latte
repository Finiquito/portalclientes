{layout '../_ingreso.latte'}

{block titulo}Ingresar · Panel del equipo · {$marca['titulo']}{/block}

{block contenido}
{include '_logo.latte'}
<div class="ing-texto">
    <span class="ing-eyebrow">Panel del equipo</span>
    <h1>Hola, equipo</h1>
    <p>Ingresa tu correo de la agencia y te enviamos un código. Sin contraseñas.</p>
</div>
<form method="post" action="/equipo/entrar" data-once class="ing-tarjeta">
    {if $error}<p role="alert" class="ing-error">Tu sesión expiró. Intenta de nuevo.</p>{/if}
    <input type="hidden" name="_csrf" value="{$csrf}">
    <label for="email">Correo de la agencia</label>
    <input id="email" type="email" name="email" placeholder="tu@agencia.com" required autofocus autocomplete="email" inputmode="email">
    <button type="submit" data-sending="Enviando código…">Enviar código</button>
</form>
<p class="ing-ayuda">¿No tienes acceso? Pídelo a quien administra el portal.</p>
{/block}
