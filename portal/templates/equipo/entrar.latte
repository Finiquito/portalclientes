<!DOCTYPE html>
<html lang="es" data-tema="auto" style="--brand: {$marca['color']|noescape}; --brand-fg: {$marca['texto']|noescape}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="csrf" content="{$csrf}">
    <meta name="robots" content="noindex, nofollow">
    <title>Ingresar · Panel de equipo · {$marca['titulo']}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="/plugins/portal/assets/portal.css?v=13">
    <script>{$portalBoot|noescape}</script>
</head>
<body class="min-h-dvh bg-bg font-sans text-ink antialiased">
<main class="relative flex min-h-dvh items-center justify-center overflow-hidden px-4 py-10">
    <div class="hero-arcs" aria-hidden="true"></div>

    <div class="reveal relative w-full max-w-md">
        <div class="mb-7 text-center">
            {if $marca['logo']}<img src="{$marca['logo']}" alt="{$marca['titulo']}" class="mx-auto mb-5 h-12 w-auto max-w-[12rem] object-contain">{/if}
            <span class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-brand text-brand-fg shadow-pop">
                <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/></svg>
            </span>
            <h1 class="mt-5 text-3xl font-extrabold tracking-tight sm:text-4xl">Panel de equipo</h1>
            <p class="mt-2 text-muted">Entra con tu correo de la agencia: te enviamos un código. Sin contraseñas.</p>
        </div>

        <div class="card card-pad">
            {if $error}
                <div role="alert" class="mb-4 rounded-xl border border-danger/30 bg-danger/10 px-4 py-3 text-sm font-medium text-danger">
                    Tu sesión expiró. Intenta de nuevo.
                </div>
            {/if}

            <form method="post" action="/equipo/entrar" data-once>
                <input type="hidden" name="_csrf" value="{$csrf}">
                <label for="email" class="label">Correo electrónico</label>
                <input id="email" type="email" name="email" placeholder="tu@agencia.com" required autofocus autocomplete="email" inputmode="email" class="field">
                <button type="submit" data-sending="Enviando código…" class="btn btn-primary mt-4 w-full">Enviar código</button>
            </form>
        </div>

        <p class="mt-5 text-center text-xs text-muted">¿No tienes acceso? Pídelo a quien administra el portal.</p>
    </div>
</main>
<script>{$portalJs|noescape}</script>
</body>
</html>
