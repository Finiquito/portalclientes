  "a tu cargo": {t('a tu cargo')},
  "Equipo": {t('Equipo')},
  "1 invitado: %s": {t('1 invitado: %s')},
  "%d invitados: %s": {t('%d invitados: %s')},
  "Lo invitas cuando quieras, desde Equipo": {t('Lo invitas cuando quieras, desde Equipo')},
  "Guardando…": {t('Guardando…')},
  "Guardado": {t('Guardado')},
  "No se pudo guardar": {t('No se pudo guardar')},
  "No se pudo guardar. Revisa tu conexión.": {t('No se pudo guardar. Revisa tu conexión.')},
  "Sin conexión · reintentando": {t('Sin conexión · reintentando')},
