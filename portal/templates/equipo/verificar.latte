{layout '../_ingreso.latte'}

{block titulo}Revisa tu correo · Panel del equipo · {$marca['titulo']}{/block}

{block contenido}
{include '_logo.latte'}
<div class="ing-texto">
    <span class="ing-eyebrow">Panel del equipo</span>
    <h1>Revisa tu correo</h1>
    <p>Te enviamos un código de 6 dígitos a <strong>{$email}</strong>. Vence en 10 minutos.</p>
</div>
<form method="post" action="/equipo/verificar" data-once class="ing-tarjeta">
    {if $error}
        <p role="alert" class="ing-error">
            {if $error === 'bloqueado'}Demasiados intentos. Espera unos minutos y pide un código nuevo.
            {elseif $error === 'sesion'}Tu sesión expiró. Vuelve a pedir el código.
            {else}El código es incorrecto o ya venció. Revísalo o pide uno nuevo.{/if}
        </p>
    {/if}
    <input type="hidden" name="_csrf" value="{$csrf}">
    <label for="codigo">Código de 6 dígitos</label>
    <input id="codigo" type="text" name="codigo" class="codigo" required autofocus data-otp inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" placeholder="······">
    <button type="submit" data-sending="Verificando…">Entrar al panel</button>
</form>
<p class="ing-ayuda">¿No llegó? <a href="/equipo/entrar">Pide otro código</a>.</p>
{/block}
