{layout '_layout.latte'}

{block title}{$cliente['nombre']}{/block}

{block content}
<a href="/equipo/clientes" class="mb-4 inline-flex items-center gap-1 text-sm font-semibold text-muted hover:text-ink"><svg class="size-4"><use href="#i-back"/></svg> Clientes</a>

<section class="reveal flex items-center gap-4 pb-6">
    {if $marcaCli['logo']}
        <img src="{$marcaCli['logo']}" alt="" class="size-16 flex-none rounded-2xl border border-line bg-white object-contain p-1.5">
    {else}
        <span class="avatar size-16! flex-none rounded-2xl! text-lg!" style="background: {$marcaCli['color']|noescape}; color: {$marcaCli['texto']|noescape}">{$fmt->iniciales($cliente['nombre'])}</span>
    {/if}
    <div class="min-w-0">
        <h1 class="truncate text-[1.75rem] font-extrabold leading-tight tracking-tight sm:text-4xl">{$cliente['nombre']}</h1>
        <p class="mt-1 text-sm text-muted">{$cliente['empresa']}{if $cliente['empresa'] && $pais} · {/if}{if $pais}{$pais[0]}{/if}</p>
    </div>
</section>

<div class="-mt-2 mb-6 flex flex-wrap gap-2">
    <a href="/equipo/proyectos/nuevo?cliente_id={$cliente['id']}" class="btn btn-primary btn-sm"><svg class="size-4"><use href="#i-briefcase"/></svg> Nuevo proyecto</a>
    <a href="/equipo/contactos/nuevo?cliente_id={$cliente['id']}" class="btn btn-soft btn-sm"><svg class="size-4"><use href="#i-users"/></svg> Nuevo contacto</a>
    {if $usuario['rol'] === 'coordinador'}<a href="/equipo/clientes/{$cliente['id']}/editar" class="btn btn-ghost btn-sm"><svg class="size-4"><use href="#i-edit"/></svg> Editar cliente y su portal</a>{/if}
</div>

<div class="xl:grid xl:grid-cols-[minmax(0,1fr)_20rem] xl:gap-6">
    <section class="min-w-0" aria-labelledby="h-proy">
        <h2 id="h-proy" class="mb-3 text-lg font-extrabold tracking-tight">Proyectos</h2>
        {if empty($proyectos)}
            <div class="card card-pad text-sm text-muted">Este cliente no tiene proyectos todavía.</div>
        {else}
            <div class="grid gap-3 sm:grid-cols-2">
                {foreach $proyectos as $p}{include '_proyecto_card.latte', p: $p, fmt: $fmt}{/foreach}
            </div>
        {/if}
    </section>

    <aside class="mt-6 min-w-0 space-y-5 xl:mt-0">
        <section class="card card-pad">
            <h2 class="text-base font-extrabold tracking-tight">Contactos</h2>
            {if empty($contactos)}
                <p class="mt-3 text-sm text-muted">Sin contactos con acceso al portal.</p>
            {else}
                <ul class="mt-4 space-y-3">
                    {foreach $contactos as $ct}
                        <li class="flex items-center gap-3">
                            <span class="avatar flex-none">{$fmt->iniciales($ct['nombre'])}</span>
                            <span class="min-w-0 flex-1 leading-snug">
                                <span class="block truncate text-sm font-semibold">{$ct['nombre']}</span>
                                <a href="mailto:{$ct['email']}" class="block truncate text-xs text-muted hover:text-brand-ink">{$ct['email']}</a>
                            </span>
                            <span class="chip {$ct['rol'] === 'aprobador' ? 'chip-brand' : 'chip-muted'}">{$ct['rol'] === 'aprobador' ? 'Aprueba' : 'Lectura'}</span>
                            <a href="/equipo/contactos/{$ct['id']}" class="text-muted hover:text-ink" aria-label="Editar contacto"><svg class="size-4"><use href="#i-edit"/></svg></a>
                        </li>
                    {/foreach}
                </ul>
            {/if}
        </section>

        <section class="card card-pad">
            <h2 class="text-base font-extrabold tracking-tight">Actividad reciente</h2>
            {if empty($actividad)}
                <p class="mt-3 text-sm text-muted">Sin movimiento todavía.</p>
            {else}
                <ul class="mt-4 space-y-4">
                    {foreach $actividad as $a}
                        <li class="flex gap-3">
                            <span class="mt-0.5 flex size-8 flex-none items-center justify-center rounded-full {$a['actor_tipo'] === 'equipo' ? 'bg-ink text-bg' : 'bg-brand-soft text-brand-ink'}">
                                <svg class="size-4"><use href="#{$fmt->iconoActividad($a['accion'])}"/></svg>
                            </span>
                            <p class="min-w-0 flex-1 text-sm leading-snug">
                                <span class="font-semibold">{$fmt->actividad($a, true)}</span>
                                {if $a['titulo']}«{$a['titulo']}»{/if}
                                <span class="mt-0.5 block text-xs text-muted">{$fmt->rel($a['created_at'])}</span>
                            </p>
                        </li>
                    {/foreach}
                </ul>
            {/if}
        </section>
    </aside>
</div>
{/block}
