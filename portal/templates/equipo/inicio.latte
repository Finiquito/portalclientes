{layout '_layout.latte'}

{block title}Inicio{/block}

{block content}
{var $nCliente = count($delCliente) + count($conCambios)}

<div class="xl:grid xl:grid-cols-[minmax(0,1fr)_20rem] xl:gap-6">
<div class="min-w-0">

    <section class="relative reveal pb-6 pt-1 sm:pb-8">
        <div class="hero-arcs" aria-hidden="true"></div>
        <p class="relative text-sm font-semibold text-brand-ink">{$fmt->fechaLarga()|firstUpper}</p>
        <h1 class="relative mt-1 text-[2rem] font-extrabold leading-[1.08] tracking-tight sm:text-5xl">{$fmt->saludo()}, {$nombre}</h1>
        <p class="relative mt-3 max-w-2xl text-base text-muted sm:text-lg">
            {if $nTurno === 0}Nada esperando al equipo por ahora. Buen momento para adelantar.
            {elseif $nCliente > 0}Hay {$nCliente} {$nCliente === 1 ? 'respuesta' : 'respuestas'} de clientes para revisar y {$nTurno} {$nTurno === 1 ? 'tarea' : 'tareas'} en tu turno.
            {else}Tienes {$nTurno} {$nTurno === 1 ? 'tarea' : 'tareas'} en el turno del equipo.{/if}
        </p>
    </section>

    <section class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4" aria-label="Resumen">
        {foreach [
            ['#h-cliente', 'i-chat',      $nCliente,   'Respuestas del cliente'],
            ['#h-mias',    'i-tasks',     count($mias), 'Asignadas a ti'],
            ['#h-equipo',  'i-alert',     $vencidas,   'Vencidas'],
            ['/equipo/clientes', 'i-briefcase', $nProyectos, 'Proyectos activos'],
        ] as $i => $k}
        <a href="{$k[0]}" class="card reveal group p-3.5 transition hover:-translate-y-0.5 hover:shadow-pop sm:p-5" style="--i:{$i + 1}">
            <span class="flex size-10 items-center justify-center rounded-xl sm:size-11 {$k[1] === 'i-alert' && $k[2] > 0 ? 'bg-danger/10 text-danger' : 'bg-brand-soft text-brand-ink'}"><svg class="size-5"><use href="#{$k[1]}"/></svg></span>
            <span class="mt-3 block text-3xl font-extrabold tracking-tight">{$k[2]}</span>
            <span class="block text-xs font-semibold text-muted sm:text-sm">{$k[3]}</span>
        </a>
        {/foreach}
    </section>

    {* Lo que el cliente respondió: primero, porque es lo que destraba el trabajo *}
    <section class="card reveal mt-5 overflow-hidden" style="--i:5" aria-labelledby="h-cliente" id="h-cliente">
        <div class="flex items-center justify-between gap-3 px-5 pb-2 pt-5 sm:px-6 sm:pt-6">
            <h2 class="text-lg font-extrabold tracking-tight">Respuestas del cliente</h2>
            {if $nCliente > 0}<span class="chip chip-warn">{$nCliente} por revisar</span>{/if}
        </div>
        {if $nCliente === 0}
            <div class="flex flex-col items-center px-6 pb-9 pt-5 text-center">
                <span class="flex size-14 items-center justify-center rounded-2xl bg-ok/10 text-ok"><svg class="size-7"><use href="#i-check"/></svg></span>
                <p class="mt-4 font-bold">Nada pendiente de los clientes</p>
                <p class="mt-1 max-w-xs text-sm text-muted">Cuando un cliente entregue archivos, pida cambios o responda una revisión, aparecerá aquí.</p>
            </div>
        {else}
            <ul class="px-2 pb-2 sm:px-3 sm:pb-3">
                {foreach $conCambios as $e}
                    <li>
                        <a href="/equipo/proyectos/{$e['proyecto_id']}#entregas" class="group flex items-center gap-3 rounded-2xl p-3 transition hover:bg-surface2 sm:p-3.5">
                            <span class="flex size-11 flex-none items-center justify-center rounded-xl bg-warn/15 text-warn"><svg class="size-5"><use href="#i-eye"/></svg></span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate font-semibold">{$e['titulo']}</span>
                                <span class="mt-0.5 block truncate text-xs text-muted">{$e['cliente_nombre']} · {$e['proyecto_nombre']} · {$e['respondida_por'] ?: 'El cliente'} envió su revisión {$fmt->rel($e['respondida_en'])}</span>
                            </span>
                            <span class="hidden flex-col items-end gap-1 sm:flex">
                                {if $e['n_cambios'] > 0}<span class="chip chip-danger">{$e['n_cambios']} con cambios</span>{/if}
                                <span class="chip chip-ok">{$e['n_aprobados']}/{$e['n_total']} aprobados</span>
                            </span>
                            <svg class="size-4 flex-none text-muted transition group-hover:translate-x-0.5"><use href="#i-chevron"/></svg>
                        </a>
                        <span class="-mt-1 mb-2 ml-[4.5rem] flex flex-wrap gap-1.5 sm:hidden">
                            {if $e['n_cambios'] > 0}<span class="chip chip-danger">{$e['n_cambios']} con cambios</span>{/if}
                            <span class="chip chip-ok">{$e['n_aprobados']}/{$e['n_total']} aprobados</span>
                        </span>
                    </li>
                {/foreach}
                {foreach $delCliente as $t}{include '_tarea.latte', t: $t, fmt: $fmt}{/foreach}
            </ul>
        {/if}
    </section>

    <section class="card reveal mt-5 overflow-hidden" style="--i:6" id="h-mias">
        <div class="flex items-center justify-between gap-3 px-5 pb-2 pt-5 sm:px-6 sm:pt-6">
            <h2 class="text-lg font-extrabold tracking-tight">Asignadas a ti</h2>
            {if count($mias) > 0}<span class="chip chip-brand">{count($mias)}</span>{/if}
        </div>
        {if empty($mias)}
            <p class="px-5 pb-6 pt-1 text-sm text-muted sm:px-6">No tienes tareas asignadas a tu nombre.</p>
        {else}
            <ul class="px-2 pb-2 sm:px-3 sm:pb-3">
                {foreach $mias as $t}{include '_tarea.latte', t: $t, fmt: $fmt}{/foreach}
            </ul>
        {/if}
    </section>

    <section class="card reveal mt-5 overflow-hidden" style="--i:7" id="h-equipo">
        <div class="flex items-center justify-between gap-3 px-5 pb-2 pt-5 sm:px-6 sm:pt-6">
            <h2 class="text-lg font-extrabold tracking-tight">Turno del equipo</h2>
            {if $nResto > 0}<span class="chip chip-muted">{$nResto}</span>{/if}
        </div>
        {if empty($resto)}
            <p class="px-5 pb-6 pt-1 text-sm text-muted sm:px-6">Sin tareas abiertas del equipo en tus proyectos.</p>
        {else}
            <ul class="px-2 pb-2 sm:px-3 sm:pb-3">
                {foreach $resto as $t}{include '_tarea.latte', t: $t, fmt: $fmt}{/foreach}
            </ul>
            {if $nResto > count($resto)}<p class="px-6 pb-5 text-sm text-muted">Y {$nResto - count($resto)} más en tus proyectos.</p>{/if}
        {/if}
    </section>
</div>

<aside class="mt-5 min-w-0 space-y-5 xl:mt-0" aria-label="Agenda y novedades">
    <section class="card card-pad reveal" style="--i:4">
        <h2 class="text-base font-extrabold tracking-tight">Próximas reuniones</h2>
        {if empty($reuniones)}
            <p class="mt-3 text-sm text-muted">No hay reuniones agendadas.</p>
        {else}
            <ul class="mt-4 space-y-3">
                {foreach $reuniones as $r}
                    <li><a href="/equipo/proyectos/{$r['proyecto_id']}#reuniones" class="flex items-center gap-3 rounded-xl transition hover:opacity-80">
                        <span class="flex size-12 flex-none flex-col items-center justify-center rounded-xl leading-none {substr((string) $r['fecha'], 0, 10) === $hoy ? 'bg-brand text-brand-fg' : 'bg-brand-soft text-brand-ink'}">
                            <span class="text-lg font-extrabold">{$fmt->dia($r['fecha'])}</span>
                            <span class="mt-0.5 text-[0.625rem] font-bold uppercase tracking-wide">{$fmt->mesCorto($r['fecha'])}</span>
                        </span>
                        <span class="min-w-0">
                            <span class="block truncate text-sm font-semibold">{$r['titulo']}</span>
                            <span class="block truncate text-xs text-muted">{$fmt->hora($r['fecha'])}{if $fmt->hora($r['fecha']) !== ''} · {/if}{$r['cliente_nombre']}</span>
                            {if !(int) $r['publicada']}<span class="mt-0.5 block text-xs font-bold text-muted">Oculta al cliente</span>{elseif $r['enlace_meet']}<span class="mt-0.5 block text-xs font-bold text-brand-ink">Con link de Meet</span>{/if}
                        </span>
                    </a></li>
                {/foreach}
            </ul>
        {/if}
    </section>

    <section class="card card-pad reveal" style="--i:5">
        <h2 class="text-base font-extrabold tracking-tight">Esperando al cliente</h2>
        {if empty($esperandoCli)}
            <p class="mt-3 text-sm text-muted">No hay contenidos publicados esperando revisión.</p>
        {else}
            <ul class="mt-4 space-y-4">
                {foreach $esperandoCli as $e}
                    {var $pct = $e['n_total'] > 0 ? (int) round(($e['n_aprobados'] + $e['n_cambios']) * 100 / $e['n_total']) : 0}
                    <li><a href="/equipo/proyectos/{$e['proyecto_id']}#entregas" class="block transition hover:opacity-80">
                        <span class="flex items-baseline justify-between gap-2">
                            <span class="truncate text-sm font-semibold">{$e['titulo']}</span>
                            <span class="flex-none text-xs text-muted">{$e['n_aprobados'] + $e['n_cambios']}/{$e['n_total']}</span>
                        </span>
                        <span class="block truncate text-xs text-muted">{$e['cliente_nombre']} · publicada {$fmt->rel($e['publicada_en'])}</span>
                        <span class="progress mt-2 block" aria-hidden="true"><span style="width: {$pct}%"></span></span>
                    </a></li>
                {/foreach}
            </ul>
        {/if}
    </section>

    <section class="card card-pad reveal" style="--i:6">
        <h2 class="text-base font-extrabold tracking-tight">Novedades de clientes</h2>
        {if empty($actividad)}
            <p class="mt-3 text-sm text-muted">Aquí verás lo que hacen los clientes en su portal.</p>
        {else}
            <ul class="mt-4 space-y-4">
                {foreach $actividad as $a}
                    <li class="flex gap-3">
                        <span class="mt-0.5 flex size-8 flex-none items-center justify-center rounded-full bg-brand-soft text-brand-ink">
                            <svg class="size-4"><use href="#{$fmt->iconoActividad($a['accion'])}"/></svg>
                        </span>
                        <p class="min-w-0 flex-1 text-sm leading-snug">
                            <span class="font-semibold">{$fmt->actividad($a, true)}</span>
                            {if $a['titulo']}«{$a['titulo']}»{/if}
                            <span class="mt-0.5 block text-xs text-muted">{$a['cliente_nombre']} · {$fmt->rel($a['created_at'])}</span>
                        </p>
                    </li>
                {/foreach}
            </ul>
        {/if}
    </section>
</aside>
</div>
{/block}
