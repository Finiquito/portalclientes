{layout '_layout.latte'}

{block title}Mensajes{/block}

{block content}
<section class="pb-6 pt-1 {$sel ? 'hidden lg:block' : ''}">
    <h1 class="text-[2rem] font-extrabold leading-tight tracking-tight sm:text-4xl">Mensajes</h1>
    <p class="mt-2 text-muted">{$usuario['rol'] === 'coordinador' ? 'Lo que conversan los clientes y el equipo en tareas, contenidos y solicitudes.' : 'Las conversaciones de tus clientes en tareas, contenidos y solicitudes.'}</p>
</section>
{include '../_mensajes.latte', base: $base, pestana: $pestana, nActivas: $nActivas, nArchivadas: $nArchivadas, nDestacadas: $nDestacadas, filtros: $filtros, opciones: $opciones, reacciones: $reacciones, puedeReaccionar: $puedeReaccionar, accionesBase: $accionesBase, conv: $conv, pag: $pag, sel: $sel, hilo: $hilo, lado: $lado, yoId: $yoId, accion: $accion, urlCosa: $urlCosa, csrfCampo: $csrfCampo, csrf: $csrf, equipo: $equipo, fmt: $fmt, marcasCli: $marcasCli}
{/block}
