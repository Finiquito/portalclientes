{* Línea de tiempo de un contacto ganado: el cuadro para agregar una nota o cambiar el estado, y los movimientos
   (llegada, estados, notas con su dueño, próximos pasos), cada uno con un lápiz para corregir la fecha.
   Lo usan el panel del equipo (y el admin) y el portal del cliente.
   Parámetros: $l (el contacto), $eventos, $estados, $base (URL del contacto, sin barra final), $csrfCampo, $csrfValor,
   $ahora (Y-m-dTH:i), $fmt, $origenes, $puedeEditar (false en vista previa o si está anonimizado) *}
{var $anon = !empty($l['anonimizado_en'])}
<div class="ll">
{if $puedeEditar && !$anon}
<form method="post" action="{$base}/linea" class="ll-comp">
    <input type="hidden" name="{$csrfCampo}" value="{$csrfValor}">
    <h2>Agregar a la línea de tiempo</h2>
    <label class="sr-only" for="ll-texto" style="position:absolute;left:-9999px">Nota</label>
    <textarea id="ll-texto" name="texto" class="ll-in" maxlength="5000" placeholder="Escribe una nota: qué pasó, qué dijo, qué sigue…"></textarea>
    <div class="ll-fila">
        <label>Ocurrió el <input type="datetime-local" name="ocurrio_en" class="ll-in" value="{$ahora}" max="{(new \DateTimeImmutable('+1 day'))->format('Y-m-d\TH:i')}"></label>
        <label>Cambiar estado (opcional)
            <select name="estado" class="ll-in">
                <option value="">Sin cambio</option>
                {foreach $estados as $k => $txt}{if $k !== $l['estado']}<option value="{$k}">{$txt}</option>{/if}{/foreach}
            </select>
        </label>
        <span class="ll-sep"></span>
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
    <p class="ll-aviso">La fecha viene con la de ahora; si pasó antes, la cambias. Queda guardado quién lo escribió y cuándo se registró.</p>
</form>
{/if}

<ol class="ll-linea" aria-label="Línea de tiempo">
{foreach $eventos as $e}
    {var $fecha = $e['ocurrio_en']}
    <li class="ll-ev">
        <div class="ll-fecha">
            {if $puedeEditar && !$anon}
            <details class="ll-edit">
                <summary aria-label="Corregir la fecha de este movimiento" title="Corregir la fecha"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 2.5l2.5 2.5L5.5 13H3v-2.5z"/></svg></summary>
                <form method="post" action="{$base}/linea/{$e['id']}/fecha">
                    <input type="hidden" name="{$csrfCampo}" value="{$csrfValor}">
                    <label>Fecha y hora
                        <input type="datetime-local" name="ocurrio_en" class="ll-in" value="{date('Y-m-d\TH:i', (int) strtotime($fecha))}" max="{(new \DateTimeImmutable('+1 day'))->format('Y-m-d\TH:i')}" required>
                    </label>
                    <p>Al guardar, la línea se reordena sola. La ven la agencia y el cliente.</p>
                    <button type="submit" class="btn btn-primary btn-sm">Guardar fecha</button>
                </form>
            </details>
            {/if}
            {$fmt->dia($fecha)} {$fmt->mesCorto($fecha)}
            <small>{$fmt->hora($fecha)}</small>
            {if !empty($e['ajustada'])}<small class="adj" title="Alguien corrigió a mano la fecha de este movimiento">fecha corregida</small>{/if}
        </div>
        <span class="ll-punto" data-t="{$e['tipo']}" {if $e['tipo'] === 'estado'}data-e="{$e['a_estado']}"{/if}></span>
        <div class="ll-cuerpo">
            {var $iniciales = $e['autor'] ? $fmt->iniciales((string) $e['autor']) : ''}
            {if $e['tipo'] === 'nota'}
                <div class="ll-nota">
                    <div class="ll-quien">
                        {if $iniciales !== ''}<span class="ll-yo" data-t="{$e['autor_tipo']}" aria-hidden="true">{$iniciales}</span>{/if}
                        {$e['autor'] ?: 'Nota'}
                        {if $e['autor_tipo']}<span class="ll-own" data-t="{$e['autor_tipo']}">{\TypeDock\Plugin\Portal\LeadLinea::AUTORES[$e['autor_tipo']] ?? ''}</span>{/if}
                        {if !empty($e['legado'])}<span class="ll-own" data-t="sistema">Nota anterior</span>{/if}
                    </div>
                    <p>{$e['texto']|breakLines}</p>
                </div>
            {elseif $e['tipo'] === 'estado'}
                <div class="ll-mov">
                    {if $e['de_estado']}<span class="ll-chip" data-e="{$e['de_estado']}">{$estados[$e['de_estado']] ?? $e['de_estado']}</span><span class="fl" aria-hidden="true">→</span>{/if}
                    <span class="ll-chip" data-e="{$e['a_estado']}">{$estados[$e['a_estado']] ?? $e['a_estado']}</span>
                </div>
            {elseif $e['tipo'] === 'proximo_paso'}
                <p class="ll-tit-ev">Próximo paso: {$e['texto']}</p>
            {else}
                <p class="ll-tit-ev">Llegó por {mb_strtolower($origenes[$l['origen']] ?? $l['origen'])}</p>
                {if $l['campana'] || $l['utm_source']}<p class="ll-meta">{if $l['campana']}Campaña {$l['campana']}{/if}{if $l['utm_source']}{if $l['campana']} · {/if}{$l['utm_source']}{if $l['utm_medium']} / {$l['utm_medium']}{/if}{/if}</p>{/if}
            {/if}
            {if $e['tipo'] !== 'nota' && ($e['autor'] || $e['autor_tipo'])}
                <div class="ll-quien">
                    {if $iniciales !== ''}<span class="ll-yo" data-t="{$e['autor_tipo']}" aria-hidden="true">{$iniciales}</span>{/if}
                    {$e['autor']}
                    {if $e['autor_tipo']}<span class="ll-own" data-t="{$e['autor_tipo']}">{\TypeDock\Plugin\Portal\LeadLinea::AUTORES[$e['autor_tipo']] ?? ''}</span>{/if}
                </div>
            {/if}
            {if !empty($e['ajustada']) || $e['registrado_en'] !== $e['ocurrio_en']}
                {if !empty($e['ajustada'])}<p class="ll-meta">Ocurrió el {$fmt->fecha($e['ocurrio_en'])} · registrada el {$fmt->fecha($e['registrado_en'])}</p>{/if}
            {/if}
        </div>
    </li>
{/foreach}
</ol>
</div>
