{layout '../_ingreso.latte'}

{block titulo}Ingresar · Portal de Clientes{/block}

{block contenido}
{include '_piezas.latte', agencia: $agencia, cliente: null, animar: false}
<div class="ing-texto">
    <span class="ing-eyebrow">Portal de Clientes</span>
    <h1>Bienvenido</h1>
    <p>Este espacio es para ti. Ingresa tu correo y te enviamos un código.</p>
</div>
<form method="post" action="/login" data-once class="ing-tarjeta">
    {if $error}<p role="alert" class="ing-error">Tu sesión expiró. Intenta de nuevo.</p>{/if}
    <input type="hidden" name="_csrf" value="{$csrf}">
    <label for="email">Correo electrónico</label>
    <input id="email" type="email" name="email" value="{$email ?? ''}" placeholder="tu@empresa.com" required autofocus autocomplete="email" inputmode="email">
    <button type="submit" data-sending="Enviando código…">Enviar código</button>
</form>
<p class="ing-ayuda">Sin contraseñas: cada vez te llega un código nuevo. ¿No tienes acceso? Escríbenos y te lo activamos.</p>
{/block}
