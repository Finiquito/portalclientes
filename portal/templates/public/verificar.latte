{layout '../_ingreso.latte'}

{block titulo}Revisa tu correo · Portal de Clientes{/block}

{block contenido}
{include '_piezas.latte', agencia: $agencia, cliente: $cliente, animar: $animar}
<div class="ing-texto">
    {if $cliente}
        <h1 class="{$animar ? 't-nuevo' : ''}">{$agencia['nombre']}<svg class="union {$animar ? 'espera' : ''}" aria-hidden="true"><use href="#corazon"/></svg>{$cliente['nombre']}</h1>
        <p class="{$animar ? 't-nuevo' : ''}"><span class="exclama">{$expresion}</span> Te enviamos un código a <strong>{$email}</strong>. Vence en 10 minutos.</p>
    {else}
        <span class="ing-eyebrow">Portal de Clientes</span>
        <h1>Revisa tu correo</h1>
        <p>Si <strong>{$email}</strong> está registrado, te llegó un código de 6 dígitos. Vence en 10 minutos.</p>
    {/if}
</div>
<form method="post" action="/verificar" data-once class="ing-tarjeta">
    {if $error}
        <p role="alert" class="ing-error">
            {if $error === 'bloqueado'}Demasiados intentos. Espera unos minutos y pide un código nuevo.
            {elseif $error === 'sesion'}Tu sesión expiró. Vuelve a pedir el código.
            {else}El código es incorrecto o ya venció. Revísalo o pide uno nuevo.{/if}
        </p>
    {/if}
    <input type="hidden" name="_csrf" value="{$csrf}">
    <label for="codigo">Código de 6 dígitos</label>
    <input id="codigo" type="text" name="codigo" class="codigo" required autofocus data-otp inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" placeholder="······">
    <button type="submit" data-sending="Verificando…">{$cliente ? 'Entrar a mi portal' : 'Entrar'}</button>
</form>
<p class="ing-ayuda">¿No llegó? Revisa spam o <a href="/login">pide otro código</a>.</p>
{/block}
