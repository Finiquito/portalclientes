{layout '_layout.latte'}

{block title}Mensajes{/block}

{block content}
<header class="reveal pb-5 pt-1 {$sel ? 'hidden lg:block' : ''}">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Mensajes</h1>
    <p class="mt-1.5 text-muted">Todo lo que conversas con el equipo en tus tareas, contenidos y solicitudes, en un solo lugar.</p>
</header>
{include '../_mensajes.latte', base: $base, pestana: $pestana, nActivas: $nActivas, nArchivadas: $nArchivadas, conv: $conv, pag: $pag, sel: $sel, hilo: $hilo, lado: $lado, yoId: $yoId, accion: $accion, urlCosa: $urlCosa, csrfCampo: $csrfCampo, csrf: $csrf, equipo: $equipo, fmt: $fmt}
{/block}
