{layout '_layout.latte'}

{block title}Contactos ganados{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/leads.css?v=7">
<header class="reveal flex flex-wrap items-end justify-between gap-4 pb-5 pt-1">
    <div>
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Contactos ganados</h1>
        <p class="mt-1.5 text-muted">Las personas que llegan por tus campañas. Anota en qué va cada una y cuál es el próximo paso.</p>
    </div>
    <div class="flex flex-wrap gap-2">
        {if $total > 0}<a href="{$exportar}" class="btn btn-ghost btn-sm"><svg class="size-4"><use href="#i-download"/></svg> Descargar CSV</a>{/if}
        {if !$vistaPrevia}<a href="/portal/contactos-ganados/nuevo" class="btn btn-primary btn-sm"><svg class="size-4"><use href="#i-plus"/></svg> Agregar contacto</a>
        {else}<span title="En vista previa se puede mirar todo, pero no agregar contactos"><span class="btn btn-primary btn-sm" aria-disabled="true"><svg class="size-4"><use href="#i-plus"/></svg> Agregar contacto</span></span>{/if}
    </div>
</header>

{* Las campañas del cliente (un proyecto = una campaña) con a quién le hablan: el B2C o B2B vive aquí, no en cada fila *}
{if count($misCampanas) > 0}
<section class="ll reveal" style="--i:1;margin-bottom:1.25rem" aria-label="Tus campañas">
    <div class="ll-campanas">
        {foreach $misCampanas as $c}
        <a href="/portal/contactos-ganados?proyecto={$c['id']}" class="ll-camp" {if $f['proyecto_id'] === $c['id']}aria-current="true"{/if}>
            <span class="ll-camp-n"><span class="ll-camp-dot" style="background:{($colorProy[$c['id']] ?? '#94a3b8')|noescape}" aria-hidden="true"></span>{$c['nombre']}{foreach $c['etiquetas'] as $t} <span class="ll-pub" data-p="{$t}">{$t}</span>{/foreach}{if $c['estado'] !== 'activo'} <span class="ll-chip" data-e="nuevo">{$c['estado'] === 'pausado' ? 'Pausada' : 'Cerrada'}</span>{/if}</span>
            <span class="ll-camp-t"><b>{$c['total']}</b> {$c['total'] === 1 ? t('contacto') : t('contactos')}</span>
        </a>
        {/foreach}
        {if $f['proyecto_id'] !== ''}<a href="/portal/contactos-ganados" class="ll-camp ll-camp-todas">Ver todas</a>{/if}
    </div>
</section>
{/if}

{* Evolución: contactos acumulados, de una etapa a la siguiente y cuánto tardan *}
{if $total > 0 && !empty($grafico['etiquetas'])}
<section class="ll ll-graf reveal" style="--i:1;margin-bottom:1.25rem" aria-labelledby="h-evo">
    <div class="ll-graf-cab">
        <div><h2 id="h-evo">Cómo van los contactos</h2><p class="ll-sub">Cuántos van llegando y siendo contactados; abajo, cuándo avanzó o se cayó alguien{if $nuevosSemana > 0} · <b style="color:var(--brand-ink)">+{$nuevosSemana} esta semana</b>{/if}</p></div>
    </div>
    {include '../_lead_grafico.latte', grafico: $grafico, corto: false, botones: true}
    {include '../_lead_embudo.latte', embudo: $embudo, tiempos: $tiempos}
</section>
{/if}

{* Pestañas por estado *}
{var $q = array_filter(['proyecto' => $f['proyecto_id'], 'campana' => $f['campana'], 'q' => $f['q']])}
<nav class="scroll-x reveal -mx-1 flex gap-2 px-1 pb-4" style="--i:1" aria-label="Filtrar por estado">
    <a href="/portal/contactos-ganados{if $q}?{http_build_query($q)}{/if}" class="btn btn-sm {$f['estado'] === '' ? 'btn-primary' : 'btn-ghost'}" {if $f['estado'] === ''}aria-current="true"{/if}>
        Todos <span class="rounded-full px-1.5 text-xs {$f['estado'] === '' ? 'bg-white/25' : 'bg-surface2 text-muted'}">{$total}</span>
    </a>
    {foreach $estados as $k => $nombre}
        <a href="/portal/contactos-ganados?{http_build_query($q + ['estado' => $k])}" class="btn btn-sm {$f['estado'] === $k ? 'btn-primary' : 'btn-ghost'}" {if $f['estado'] === $k}aria-current="true"{/if}>
            {$nombre} <span class="rounded-full px-1.5 text-xs {$f['estado'] === $k ? 'bg-white/25' : 'bg-surface2 text-muted'}">{$conteo[$k]}</span>
        </a>
    {/foreach}
</nav>

{* Búsqueda y filtros *}
<form method="get" action="/portal/contactos-ganados" class="reveal mb-4 flex flex-wrap items-end gap-3" style="--i:2" role="search">
    {if $f['estado'] !== ''}<input type="hidden" name="estado" value="{$f['estado']}">{/if}
    <div class="min-w-[12rem] flex-1">
        <label for="l-q" class="label">Buscar</label>
        <input id="l-q" type="search" name="q" value="{$f['q']}" class="field" placeholder="Nombre, correo, teléfono o empresa">
    </div>
    {if count($proyectos) > 1}
    <div>
        <label for="l-p" class="label">Proyecto</label>
        <select id="l-p" name="proyecto" class="field">
            <option value="">Todos los proyectos</option>
            {foreach $proyectos as $p}<option value="{$p['id']}" {if $f['proyecto_id'] === $p['id']}selected{/if}>{$p['nombre']}</option>{/foreach}
        </select>
    </div>
    {/if}
    {if $campanas}
    <div>
        <label for="l-c" class="label">Origen</label>
        <select id="l-c" name="campana" class="field">
            <option value="">Todas</option>
            {foreach $campanas as $cp}<option value="{$cp}" {if $f['campana'] === $cp}selected{/if}>{$cp}</option>{/foreach}
        </select>
    </div>
    {/if}
    <button type="submit" class="btn btn-ghost btn-sm">Filtrar</button>
    {if $f['q'] !== '' || $f['campana'] !== '' || $f['proyecto_id'] !== ''}<a href="/portal/contactos-ganados{if $f['estado'] !== ''}?estado={$f['estado']}{/if}" class="btn btn-ghost btn-sm">Limpiar</a>{/if}
</form>

<section class="card reveal overflow-hidden" style="--i:3">
    {if empty($leads)}
        <div class="flex flex-col items-center px-6 py-14 text-center">
            <span class="flex size-14 items-center justify-center rounded-2xl bg-brand-soft text-brand-ink"><svg class="size-7"><use href="#i-users"/></svg></span>
            <p class="mt-4 font-bold">{if $total === 0}Todavía no llegan contactos{else}Nada con esos filtros{/if}</p>
            <p class="mt-1 max-w-xs text-sm text-muted">{if $total === 0}Cuando alguien deje sus datos en tu campaña, aparece aquí y te avisamos por correo.{else}Prueba con otra búsqueda o estado.{/if}</p>
        </div>
    {else}
        {* Orden: a la vista arriba, también en el celular; «Invertir» da vuelta la columna elegida *}
        {var $ordenBase = [['llego', 'llego_desc', 'Cuándo llegó'], ['nombre', 'nombre_asc', 'Nombre'], ['estado', 'estado_asc', 'Estado'], ['paso', 'paso_asc', 'Próximo paso']]}
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-line px-4 py-3 text-sm">
            <p class="text-muted"><span class="font-semibold text-ink">{$total === 1 ? t('1 contacto') : t('%d contactos', $total)}</span></p>
            <form method="get" class="flex w-full items-center gap-2 sm:w-auto" data-paginacion>
                {foreach $pag->ocultos() as $k => $v}<input type="hidden" name="{$k}" value="{$v}">{/foreach}
                {if $pag->porPagina}<input type="hidden" name="por" value="{$pag->porPagina}">{/if}
                <label class="flex min-w-0 flex-1 items-center gap-2 text-muted sm:flex-none"><span class="sr-only whitespace-nowrap sm:not-sr-only">Ordenar por</span>
                    <select name="orden" class="field w-full! min-w-0 py-1.5! pr-8! text-sm sm:w-auto!" onchange="this.form.submit()">
                        {foreach $ordenBase as [$b, $k, $et]}<option value="{$k}" {if str_starts_with($pag->orden, $b . '_')}selected{/if}>{$et}</option>{/foreach}
                    </select>
                </label>
                <a href="{$pag->urlInvertirColumna()}" class="btn btn-ghost btn-sm shrink-0" title="Dar vuelta el orden"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16M7 20l-3-3M7 20l3-3M17 20V4M17 4l-3 3M17 4l3 3"/></svg> <span class="hidden sm:inline">Invertir orden</span><span class="sm:hidden">Invertir</span></a>
                <noscript><button type="submit" class="btn btn-ghost btn-sm">Aplicar</button></noscript>
            </form>
        </div>
        {* Escritorio: tabla, como la del panel del equipo *}
        <div class="hidden overflow-x-auto p-2 lg:block">
            <table class="w-full border-collapse text-sm">
                <thead>
                    <tr class="text-left text-xs font-bold text-muted">
                        {var $sc = $pag->sentidoColumna('nombre')}<th class="whitespace-nowrap border-b border-line px-3 py-2.5" {if $sc}aria-sort="{$sc === 'asc' ? 'ascending' : 'descending'}"{/if}><a href="{$pag->urlColumna('nombre')}" class="inline-flex items-center gap-1 hover:text-ink {$sc ? 'text-ink' : ''}">Contacto<span aria-hidden="true" class="{$sc ? '' : 'opacity-30'}">{$sc === 'asc' ? '↑' : ($sc === 'desc' ? '↓' : '↕')}</span></a></th>
                        {if count($proyectos) > 1}<th class="whitespace-nowrap border-b border-line px-3 py-2.5">Proyecto</th>{/if}
                        <th class="whitespace-nowrap border-b border-line px-3 py-2.5">Origen</th>
                        {var $sc = $pag->sentidoColumna('estado')}<th class="whitespace-nowrap border-b border-line px-3 py-2.5" {if $sc}aria-sort="{$sc === 'asc' ? 'ascending' : 'descending'}"{/if}><a href="{$pag->urlColumna('estado')}" class="inline-flex items-center gap-1 hover:text-ink {$sc ? 'text-ink' : ''}">Estado<span aria-hidden="true" class="{$sc ? '' : 'opacity-30'}">{$sc === 'asc' ? '↑' : ($sc === 'desc' ? '↓' : '↕')}</span></a></th>
                        <th class="whitespace-nowrap border-b border-line px-3 py-2.5">Mailchimp</th>
                        {var $sc = $pag->sentidoColumna('llego')}<th class="whitespace-nowrap border-b border-line px-3 py-2.5" {if $sc}aria-sort="{$sc === 'asc' ? 'ascending' : 'descending'}"{/if}><a href="{$pag->urlColumna('llego')}" class="inline-flex items-center gap-1 hover:text-ink {$sc ? 'text-ink' : ''}">Llegó<span aria-hidden="true" class="{$sc ? '' : 'opacity-30'}">{$sc === 'asc' ? '↑' : ($sc === 'desc' ? '↓' : '↕')}</span></a></th>
                        {var $sc = $pag->sentidoColumna('paso')}<th class="whitespace-nowrap border-b border-line px-3 py-2.5" {if $sc}aria-sort="{$sc === 'asc' ? 'ascending' : 'descending'}"{/if}><a href="{$pag->urlColumna('paso')}" class="inline-flex items-center gap-1 hover:text-ink {$sc ? 'text-ink' : ''}">Próximo paso<span aria-hidden="true" class="{$sc ? '' : 'opacity-30'}">{$sc === 'asc' ? '↑' : ($sc === 'desc' ? '↓' : '↕')}</span></a></th>
                    </tr>
                </thead>
                <tbody>
                {foreach $leads as $l}
                    {var $abierto = !in_array($l['estado'], ['ganado', 'perdido'], true)}
                    {var $vencido = $l['proximo_paso_fecha'] && $l['proximo_paso_fecha'] < $hoy && $abierto}
                    {var $correos = \TypeDock\Plugin\Portal\LeadService::mcCorreos($l)}
                    <tr class="group cursor-pointer align-top transition hover:bg-surface2 [&:not(:last-child)>td]:border-b [&>td]:border-line" onclick="if(!event.target.closest('a'))location.href=this.querySelector('a').href">
                        <td class="px-3 py-3">
                            <a href="/portal/contactos-ganados/{$l['id']}" class="font-semibold group-hover:underline">{$l['nombre']}</a>
                            <span class="block break-all text-xs text-muted">{$l['correo'] ?: $l['telefono']}</span>
                            {if $l['empresa'] && $l['empresa'] !== $l['nombre']}<span class="block text-xs text-muted">{$l['empresa']}</span>{/if}
                        </td>
                        {if count($proyectos) > 1}<td class="px-3 py-3"><span class="inline-flex items-center gap-1.5 font-semibold"><span aria-hidden="true" style="display:inline-block;width:.6rem;height:.6rem;border-radius:9999px;flex:none;background:{($colorProy[$l['proyecto_id']] ?? '#94a3b8')|noescape}"></span>{$l['proyecto_nombre']}</span></td>{/if}
                        <td class="px-3 py-3">{$l['campana'] ?: ($origenes[$l['origen']] ?? $l['origen'])}</td>
                        <td class="px-3 py-3"><span class="chip {$chips[$l['estado']]}">{$estados[$l['estado']]}</span></td>
                        <td class="px-3 py-3">
                            {if $l['mc_estado'] && isset($mcEstados[$l['mc_estado']])}
                                <span class="{in_array($l['mc_estado'], ['unsubscribed', 'cleaned'], true) ? 'font-semibold text-warn' : ''}">{$mcEstados[$l['mc_estado']][0]}</span>
                                {if $correos}<span class="mt-0.5 flex items-center gap-1 text-xs text-muted"><svg class="size-3.5"><use href="#i-mail"/></svg>{$correos}</span>{/if}
                            {else}<span class="text-muted">—</span>{/if}
                        </td>
                        <td class="whitespace-nowrap px-3 py-3">{$fmt->rel($l['created_at'])}</td>
                        <td class="px-3 py-3">
                            {if $l['proximo_paso'] && $abierto}{$l['proximo_paso']}{if $l['proximo_paso_fecha']}<span class="mt-0.5 flex items-center gap-1 text-xs {$vencido ? 'font-bold text-danger' : 'text-muted'}"><svg class="size-3.5"><use href="#i-clock"/></svg>{$fmt->fechaCorta($l['proximo_paso_fecha'])}</span>{/if}{else}<span class="text-muted">—</span>{/if}
                        </td>
                    </tr>
                {/foreach}
                </tbody>
            </table>
        </div>
        {* Celular y tablet: la lista de tarjetas *}
        <ul class="divide-y divide-line/70 p-1.5 sm:p-2 lg:hidden">
            {foreach $leads as $l}
                {var $vencido = $l['proximo_paso_fecha'] && $l['proximo_paso_fecha'] < $hoy && !in_array($l['estado'], ['ganado', 'perdido'], true)}
                <li>
                    <a href="/portal/contactos-ganados/{$l['id']}" class="group flex items-center gap-3 rounded-2xl p-3 transition hover:bg-surface2 sm:p-3.5">
                        <span class="avatar flex-none">{$fmt->iniciales($l['nombre'])}</span>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate font-semibold">{$l['nombre']}{if $l['empresa'] && $l['empresa'] !== $l['nombre']} <span class="font-normal text-muted">· {$l['empresa']}</span>{/if}</span>
                            <span class="mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-muted">
                                {if $l['correo']}<span class="break-all">{$l['correo']}</span>{elseif $l['telefono']}<span>{$l['telefono']}</span>{/if}
                                {if count($proyectos) > 1}<span class="inline-flex items-center gap-1.5 font-semibold"><span aria-hidden="true" style="display:inline-block;width:.6rem;height:.6rem;border-radius:9999px;flex:none;background:{($colorProy[$l['proyecto_id']] ?? '#94a3b8')|noescape}"></span>{$l['proyecto_nombre']}</span>{/if}
                                {if $l['campana']}<span>{$l['campana']}</span>{/if}
                                <span>{$fmt->rel($l['created_at'])}</span>
                                {if in_array($l['mc_estado'], ['unsubscribed', 'cleaned', 'subscribed'], true)}<span class="{$l['mc_estado'] === 'subscribed' ? '' : 'font-semibold text-warn'}">{['subscribed' => 'En Mailchimp', 'unsubscribed' => 'Se dio de baja en Mailchimp', 'cleaned' => 'Correo rebotado'][$l['mc_estado']]}</span>{/if}
                                {var $correos = \TypeDock\Plugin\Portal\LeadService::mcCorreos($l)}{if $correos}<span class="inline-flex items-center gap-1"><svg class="size-3.5"><use href="#i-mail"/></svg>{$correos}</span>{/if}
                            </span>
                            {if ($l['proximo_paso'] || $l['proximo_paso_fecha']) && !in_array($l['estado'], ['ganado', 'perdido'], true)}
                                <span class="mt-1.5 flex items-start gap-1.5 text-xs {$vencido ? 'font-bold text-danger' : 'text-ink'}"><svg class="mt-px size-3.5 flex-none"><use href="#i-clock"/></svg><span>{if $l['proximo_paso']}{$l['proximo_paso']}{/if}{if $l['proximo_paso'] && $l['proximo_paso_fecha']} · {/if}{if $l['proximo_paso_fecha']}{$fmt->fechaCorta($l['proximo_paso_fecha'])}{/if}</span></span>
                            {/if}
                        </span>
                        <span class="chip {$chips[$l['estado']]} hidden sm:inline-flex">{$estados[$l['estado']]}</span>
                        <svg class="size-4 flex-none text-muted transition group-hover:translate-x-0.5"><use href="#i-chevron"/></svg>
                    </a>
                    <span class="chip {$chips[$l['estado']]} -mt-1 mb-2.5 ml-[4.25rem] sm:hidden">{$estados[$l['estado']]}</span>
                </li>
            {/foreach}
        </ul>
        <div class="border-t border-line px-4">{include '../_paginacion.latte', pag: $pag, ordenSelector: false}</div>
    {/if}
</section>
{include '../_lead_scripts.latte'}
{/block}
