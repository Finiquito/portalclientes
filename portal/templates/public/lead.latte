{layout '_layout.latte'}

{block title}{$l['nombre']}{/block}

{block content}
{var $anonimo = !empty($l['anonimizado_en'])}
<a href="/portal/contactos-ganados" class="reveal mb-3 inline-flex items-center gap-1.5 text-sm font-semibold text-muted transition hover:text-ink">
    <svg class="size-4"><use href="#i-back"/></svg> Contactos ganados
</a>

<div class="lg:grid lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-6">
<div class="flex min-w-0 flex-col gap-5">

    <section class="card card-pad reveal">
        <div class="flex items-start gap-4">
            <span class="avatar size-12! flex-none text-base!">{$fmt->iniciales($l['nombre'])}</span>
            <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="chip {$chips[$l['estado']]}">{$estados[$l['estado']]}</span>
                    {if $l['campana']}<span class="chip chip-muted">{$l['campana']}</span>{/if}
                </div>
                <h1 class="mt-2 break-words text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl">{$l['nombre']}</h1>
                {if $l['empresa'] && $l['empresa'] !== $l['nombre']}<p class="mt-0.5 text-muted">{$l['empresa']}</p>{/if}
            </div>
        </div>
        {if $anonimo}
            <p class="mt-4 rounded-2xl bg-surface2 px-4 py-3 text-sm text-muted">Este contacto fue anonimizado el {$fmt->fecha($l['anonimizado_en'])}: sus datos personales se borraron y sólo queda para los conteos.</p>
        {else}
            <div class="mt-4 flex flex-wrap gap-2">
                {if $l['correo']}<a href="mailto:{$l['correo']}" class="btn btn-ghost btn-sm min-w-0"><svg class="size-4 flex-none"><use href="#i-mail"/></svg> <span class="break-all">{$l['correo']}</span></a>{/if}
                {if $l['telefono']}<a href="tel:{$l['telefono']}" class="btn btn-ghost btn-sm">{$l['telefono']}</a>{/if}
            </div>
        {/if}
    </section>

    {if !$anonimo}
    <form method="post" action="/portal/contactos-ganados/{$l['id']}" class="card card-pad reveal space-y-5" style="--i:1">
        <input type="hidden" name="_csrf" value="{$csrf}">
        <h2 class="text-lg font-extrabold tracking-tight">Seguimiento</h2>

        <fieldset>
            <legend class="label">Estado</legend>
            <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-5">
                {foreach $estados as $k => $nombre}
                    <label class="opcion"><input type="radio" name="estado" value="{$k}" class="sr-only" {if $l['estado'] === $k}checked{/if}><span class="font-semibold">{$nombre}</span></label>
                {/foreach}
            </div>
            {if $l['estado_por'] && $l['estado_en']}<p class="mt-2 text-xs text-muted">Último cambio: {$l['estado_por']}, {$fmt->rel($l['estado_en'])}.</p>{/if}
        </fieldset>

        <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_11rem]">
            <div>
                <label for="l-paso" class="label">Próximo paso</label>
                <input id="l-paso" name="proximo_paso" type="text" maxlength="255" class="field" value="{$l['proximo_paso']}" placeholder="Ej.: llamarla para enviar cotización">
            </div>
            <div>
                <label for="l-fecha" class="label">¿Cuándo?</label>
                <input id="l-fecha" name="proximo_paso_fecha" type="date" class="field" value="{$l['proximo_paso_fecha']}">
            </div>
        </div>

        <div>
            <label for="l-notas" class="label">Notas</label>
            <textarea id="l-notas" name="notas" rows="4" maxlength="5000" data-autogrow class="field" placeholder="Lo que conversaron, qué le interesa…">{$l['notas']}</textarea>
        </div>

        <details class="rounded-2xl border border-line px-4 py-3">
            <summary class="cursor-pointer text-sm font-semibold">Corregir datos de contacto</summary>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div><label for="l-nombre" class="label">Nombre</label><input id="l-nombre" name="nombre" type="text" maxlength="255" class="field" value="{$l['nombre']}"></div>
                <div><label for="l-empresa" class="label">Empresa</label><input id="l-empresa" name="empresa" type="text" maxlength="255" class="field" value="{$l['empresa']}"></div>
                <div><label for="l-correo" class="label">Correo</label><input id="l-correo" name="correo" type="email" maxlength="255" class="field" value="{$l['correo']}"></div>
                <div><label for="l-tel" class="label">Teléfono</label><input id="l-tel" name="telefono" type="tel" maxlength="64" class="field" value="{$l['telefono']}"></div>
            </div>
        </details>

        <button type="submit" class="btn btn-primary">Guardar</button>
    </form>

    {* Datos personales: lo que pide la ley si la persona lo solicita *}
    <section class="card card-pad reveal" style="--i:2" aria-labelledby="h-datos">
        <h2 id="h-datos" class="font-extrabold">Datos personales</h2>
        <p class="mt-1 text-sm text-muted">Si esta persona te pide que borres sus datos: <strong class="text-ink">anonimizar</strong> borra nombre, correo, teléfono, empresa y notas, pero lo deja en los conteos de la campaña. <strong class="text-ink">Eliminar</strong> lo borra por completo.</p>
        <div class="mt-3 flex flex-wrap gap-2">
            <form method="post" action="/portal/contactos-ganados/{$l['id']}/anonimizar" data-confirm="¿Anonimizar a {$l['nombre']}? Sus datos personales se borran y no se pueden recuperar.">
                <input type="hidden" name="_csrf" value="{$csrf}">
                <button type="submit" class="btn btn-ghost btn-sm">Anonimizar</button>
            </form>
            <form method="post" action="/portal/contactos-ganados/{$l['id']}/eliminar" data-confirm="¿Eliminar a {$l['nombre']}? Se borra por completo y no se puede deshacer.">
                <input type="hidden" name="_csrf" value="{$csrf}">
                <button type="submit" class="btn btn-ghost btn-sm text-danger">Eliminar</button>
            </form>
        </div>
    </section>
    {else}
    <form method="post" action="/portal/contactos-ganados/{$l['id']}/eliminar" class="reveal" data-confirm="¿Eliminar este registro por completo?">
        <input type="hidden" name="_csrf" value="{$csrf}">
        <button type="submit" class="btn btn-ghost btn-sm text-danger">Eliminar el registro</button>
    </form>
    {/if}
</div>

<aside class="mt-5 lg:mt-0">
    <section class="card card-pad reveal text-sm" style="--i:2">
        <h2 class="font-extrabold">De dónde llegó</h2>
        <dl class="mt-3 space-y-2.5">
            <div><dt class="text-xs text-muted">Proyecto</dt><dd class="font-semibold">{$l['proyecto_nombre']}</dd></div>
            <div><dt class="text-xs text-muted">Origen</dt><dd class="font-semibold">{$origenes[$l['origen']] ?? $l['origen']}</dd></div>
            {if $l['campana']}<div><dt class="text-xs text-muted">Campaña</dt><dd class="break-words font-semibold">{$l['campana']}</dd></div>{/if}
            {if $l['utm_source'] || $l['utm_medium']}<div><dt class="text-xs text-muted">Fuente / medio</dt><dd class="break-words font-semibold">{$l['utm_source'] ?: '—'} / {$l['utm_medium'] ?: '—'}</dd></div>{/if}
            <div><dt class="text-xs text-muted">Llegó</dt><dd class="font-semibold">{$fmt->fecha($l['created_at'])}</dd></div>
            {if $l['creado_por'] && $l['origen'] === 'manual'}<div><dt class="text-xs text-muted">Lo agregó</dt><dd class="font-semibold">{$l['creado_por']}</dd></div>{/if}
        </dl>
    </section>

    {if $conMc}
    <section class="card card-pad reveal mt-5 text-sm" style="--i:3" aria-labelledby="h-mc">
        <h2 id="h-mc" class="font-extrabold">En Mailchimp</h2>
        <p class="mt-0.5 text-xs text-muted">Audiencia «{$l['mc_audiencia_nombre']}». Sólo consultamos: no se cambia nada allá.</p>
        {if !empty($mcError)}<p class="mt-2 text-xs font-semibold text-danger">{$mcError}</p>{/if}
        {if !$l['correo'] || $l['anonimizado_en']}
            <p class="mt-3 text-muted">Sin correo no se puede revisar.</p>
        {elseif !$mc}
            <p class="mt-3 text-muted">Todavía no se revisa.</p>
        {else}
            <p class="mt-3"><span class="chip chip-{$mc['etiqueta'][1] === 'gris' ? 'muted' : $mc['etiqueta'][1]}">{$mc['etiqueta'][0]}</span></p>
            {if $mc['estado'] !== 'no_esta' && $mc['estado'] !== 'error'}
            <dl class="mt-3 space-y-2.5">
                {if !empty($mc['alta'])}<div><dt class="text-xs text-muted">Se inscribió</dt><dd class="font-semibold">{$fmt->fecha($mc['alta'])}</dd></div>{/if}
                {if $mc['estado'] === 'unsubscribed' && !empty($mc['cambio'])}<div><dt class="text-xs text-muted">Se dio de baja</dt><dd class="font-semibold">{$fmt->fecha($mc['cambio'])}{if !empty($mc['motivo'])} · «{$mc['motivo']}»{/if}</dd></div>{/if}
                {if !empty($mc['rating'])}<div><dt class="text-xs text-muted">Calificación de Mailchimp</dt><dd class="font-semibold tracking-widest text-warn" aria-label="{$mc['rating']} de 5">{str_repeat('★', $mc['rating'])}<span class="text-line">{str_repeat('★', 5 - $mc['rating'])}</span></dd></div>{/if}
                {if !empty($mc['conteo'])}{var $c = $mc['conteo']}<div><dt class="text-xs text-muted">Correos que ha recibido</dt><dd class="font-semibold">{if $c['enviados'] === 0}Todavía ninguno{else}{if !$c['completo']}Al menos {/if}{$c['enviados']} · abrió {$c['abiertos']}{if $c['enviados'] > 0} ({round($c['abiertos'] * 100 / $c['enviados'])}%){/if}{if $c['clics'] > 0} · hizo clic en {$c['clics']}{/if}{/if}</dd></div>{/if}
                {if isset($mc['aperturas']) && $mc['aperturas'] !== null}<div><dt class="text-xs text-muted">Abre / hace clic (promedio)</dt><dd class="font-semibold">{$mc['aperturas']}% / {$mc['clics'] ?? 0}%</dd></div>{/if}
                {if !empty($mc['etiquetas'])}<div><dt class="text-xs text-muted">Etiquetas</dt><dd class="mt-1 flex flex-wrap gap-1">{foreach $mc['etiquetas'] as $t}<span class="chip chip-muted">{$t}</span>{/foreach}</dd></div>{/if}
            </dl>
            {if !empty($mc['actividad'])}
                <h3 class="mt-4 text-xs font-bold uppercase tracking-wide text-muted">Últimos correos</h3>
                <ul class="mt-2 space-y-2">
                    {foreach $mc['actividad'] as $a}
                        <li class="leading-snug"><span class="font-semibold">{$mcEventos[$a['tipo']] ?? $a['tipo']}</span>{if $a['titulo']} «{$a['titulo']}»{/if} <span class="block text-xs text-muted">{$fmt->rel($a['fecha'])}</span></li>
                    {/foreach}
                </ul>
            {/if}
            {/if}
            {if $mc['estado'] === 'error' && !empty($mc['error'])}<p class="mt-2 text-xs text-muted">{$mc['error']}</p>{/if}
            <p class="mt-3 text-xs text-muted">Revisado {$fmt->rel($mc['revisado'])}.</p>
        {/if}
        {if $l['correo'] && !$l['anonimizado_en'] && !$vistaPrevia}
        <form method="post" action="/portal/contactos-ganados/{$l['id']}/mailchimp" class="mt-3">
            <input type="hidden" name="_csrf" value="{$csrf}">
            <button type="submit" class="btn btn-ghost btn-sm">Revisar ahora</button>
        </form>
        {/if}
    </section>
    {/if}
</aside>
</div>
{/block}
