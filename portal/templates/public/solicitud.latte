{layout '_layout.latte'}

{block title}{$s['titulo']}{/block}

{block content}
{var $t = $tipos[$s['tipo']]}
{var $e = $estadosS[$s['estado']] ?? ['—', 'muted']}
{if $s['estado'] === 'en_curso' && $s['tarea_estado'] === 'hecha'}{var $e = ['Lista', 'ok']}{/if}

<a href="/portal/solicitudes" class="reveal mb-3 inline-flex items-center gap-1.5 text-sm font-semibold text-muted transition hover:text-ink">
    <svg class="size-4"><use href="#i-back"/></svg> Solicitudes
</a>

<div class="lg:grid lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-6">
<div class="flex min-w-0 flex-col gap-5">

    <section class="card card-pad reveal">
        <div class="flex flex-wrap items-center gap-2">
            <span class="chip {$s['tipo'] === 'problema' ? 'chip-danger' : 'chip-brand'}"><svg class="size-3.5"><use href="#{$t[2]}"/></svg>{$t[0]}</span>
            <span class="chip chip-{$e[1]}">{$e[0]}</span>
            {if $s['urgencia'] === 'urgente'}<span class="chip chip-danger"><svg class="size-3.5"><use href="#i-flag"/></svg>Urgente</span>{/if}
        </div>
        <h1 class="mt-3 text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl">{$s['titulo']}</h1>
        {if $s['detalle']}
            <div class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-ink/85">{$s['detalle']|breakLines}</div>
        {/if}
        {if $s['urgencia'] === 'urgente' && $s['motivo_urgencia']}
            <p class="mt-3 text-sm text-muted"><strong class="text-ink">Por qué es urgente:</strong> {$s['motivo_urgencia']}</p>
        {/if}
        {if $s['tipo'] === 'reunion' && $horarios}
            <p class="mt-4 text-xs font-bold uppercase tracking-wide text-muted">Horarios que propusiste · {$modalidades[$s['modalidad']] ?? 'Videollamada'} · hora de {\TypeDock\Plugin\Portal\HorarioHabil::nombreDe($paisCliente)} <span aria-hidden="true">{\TypeDock\Plugin\Portal\Fmt::bandera($paisCliente)}</span></p>
            <ul class="mt-2 flex flex-wrap gap-2">
                {foreach $horarios as $h}<li class="chip chip-muted">{$fmt->fecha($h)} · {substr($h, 11, 5)}</li>{/foreach}
            </ul>
        {/if}

        {* Dónde va *}
        <div class="mt-5 flex items-start gap-3 rounded-2xl px-4 py-3 text-sm
            {$e[1] === 'ok' ? 'bg-ok/10 text-ok' : ($s['estado'] === 'cotizada' ? 'bg-brand-soft text-brand-ink' : 'bg-surface2 text-muted')}">
            <svg class="mt-0.5 size-5 flex-none"><use href="#{$e[1] === 'ok' ? 'i-check' : ($s['estado'] === 'cotizada' ? 'i-sparkles' : 'i-clock')}"/></svg>
            <p class="font-semibold leading-snug">
                {switch $s['estado']}
                    {case 'nueva'}La recibimos{if $s['tipo'] === 'problema'} y avisamos al equipo de inmediato{/if}. Te avisamos cuando la tomemos.
                    {case 'en_curso'}{if $s['tarea_estado'] === 'hecha'}¡Lista! La terminamos.{else}La tomamos: ya es una tarea del equipo.{/if}
                    {case 'cotizada'}Tu cotización está lista. Revísala abajo y cuéntanos si la aprobamos.
                    {case 'aprobada'}Aprobaste el presupuesto. Ya le avisamos al equipo para empezar.
                    {case 'no_aprobada'}No aprobaste esta cotización. Si quieres ajustarla, escríbenos abajo.
                    {case 'agendada'}Reunión confirmada.
                    {case 'respondida'}Te respondimos.
                    {case 'rechazada'}Esta vez no la vamos a tomar.
                {/switch}
            </p>
        </div>
    </section>

    {* Respuesta del equipo *}
    {if $s['estado'] === 'en_curso' && $s['tarea_id']}
        <a href="/portal/tareas/{$s['tarea_id']}" class="card reveal group flex items-center gap-4 p-4 transition hover:shadow-pop sm:p-5" style="--i:1">
            <span class="flex size-11 flex-none items-center justify-center rounded-xl bg-brand-soft text-brand-ink"><svg class="size-5"><use href="#i-tasks"/></svg></span>
            <span class="min-w-0 flex-1">
                <span class="block text-xs text-muted">Sigue en la tarea</span>
                <span class="block truncate font-bold">{$s['tarea_titulo']}</span>
            </span>
            <span class="chip chip-{$fmt->estado((string) $s['tarea_estado'])[1]}">{$fmt->estado((string) $s['tarea_estado'])[0]}</span>
            <svg class="size-4 flex-none text-muted transition group-hover:translate-x-0.5"><use href="#i-chevron"/></svg>
        </a>
    {elseif $s['estado'] === 'agendada' && $s['reunion_id']}
        <a href="/portal/reuniones/{$s['reunion_id']}" class="card reveal group flex items-center gap-4 p-4 transition hover:shadow-pop sm:p-5" style="--i:1">
            <span class="flex size-12 flex-none flex-col items-center justify-center rounded-xl bg-brand-soft leading-none text-brand-ink">
                <span class="text-lg font-extrabold">{$fmt->dia($reunionLocal)}</span>
                <span class="mt-0.5 text-[0.625rem] font-bold uppercase tracking-wide">{$fmt->mesCorto($reunionLocal)}</span>
            </span>
            <span class="min-w-0 flex-1">
                <span class="block text-xs text-muted">Reunión confirmada</span>
                <span class="block font-bold">{$fmt->fechaCorta($reunionLocal)}{if $fmt->hora($reunionLocal) !== ''} · {$fmt->hora($reunionLocal)} <span class="font-normal text-muted">hora de {\TypeDock\Plugin\Portal\HorarioHabil::nombreDe($paisCliente)}</span>{/if}</span>
            </span>
            <svg class="size-4 flex-none text-muted transition group-hover:translate-x-0.5"><use href="#i-chevron"/></svg>
        </a>
    {/if}

    {if in_array($s['tipo'], ['presupuesto'], true) && $s['monto']}
        <section class="card card-pad reveal {$s['estado'] === 'cotizada' ? 'border-brand/30' : ''}" style="--i:1" aria-labelledby="h-cot">
            <h2 id="h-cot" class="text-lg font-extrabold tracking-tight">Cotización</h2>
            <p class="mt-3 text-3xl font-extrabold tracking-tight">{$s['monto']}</p>
            {if $s['validez']}<p class="mt-1 text-sm text-muted">Válida hasta el {$fmt->fecha($s['validez'])}.</p>{/if}
            {if $s['respuesta']}<div class="mt-4 max-w-prose text-[0.9375rem] leading-relaxed text-ink/85">{$s['respuesta']|breakLines}</div>{/if}
            {if $s['atendida_por']}<p class="mt-3 text-xs text-muted">{$s['atendida_por']} · {$fmt->rel($s['atendida_en'])}</p>{/if}

            {if $s['estado'] === 'cotizada'}
                <form method="post" action="/portal/solicitudes/{$s['id']}/decidir" data-once class="mt-5 border-t border-line pt-5">
                    <input type="hidden" name="_csrf" value="{$csrf}">
                    <label for="dec-cuerpo" class="label">Comentario <span class="font-normal text-muted">(opcional)</span></label>
                    <textarea id="dec-cuerpo" name="cuerpo" rows="2" maxlength="4000" data-autogrow class="field" placeholder="Ej.: dale, partimos el lunes"></textarea>
                    <div class="mt-4 flex flex-col gap-2.5 sm:flex-row">
                        <button type="submit" name="decision" value="aprobar" data-sending="Guardando…" class="btn btn-ok flex-1 sm:flex-none"><svg class="size-5"><use href="#i-check"/></svg> Aprobar presupuesto</button>
                        <button type="submit" name="decision" value="no" data-sending="Guardando…" class="btn btn-ghost flex-1 sm:flex-none">No por ahora</button>
                    </div>
                </form>
            {/if}
        </section>
    {elseif in_array($s['estado'], ['respondida', 'rechazada'], true) && $s['respuesta']}
        <section class="card card-pad reveal" style="--i:1">
            <h2 class="text-lg font-extrabold tracking-tight">Respuesta del equipo</h2>
            <div class="mt-3 max-w-prose text-[0.9375rem] leading-relaxed text-ink/85">{$s['respuesta']|breakLines}</div>
            {if $s['atendida_por']}<p class="mt-3 text-xs text-muted">{$s['atendida_por']} · {$fmt->rel($s['atendida_en'])}</p>{/if}
        </section>
    {/if}

    {if $archivosS}
        <section class="card card-pad reveal" style="--i:2" aria-labelledby="h-adj">
            <h2 id="h-adj" class="text-lg font-extrabold tracking-tight">Adjuntos</h2>
            <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
                {foreach $archivosS as $a}
                    <li class="min-w-0">
                        <a href="/portal/archivo/{$a['id']}{if $fmt->esImagen($a['mime']) || $a['mime'] === 'application/pdf'}?i=1{/if}" target="_blank" rel="noopener" class="flex h-full items-center gap-3 rounded-xl border border-line bg-surface2 p-3 transition hover:border-brand/50">
                            <span class="flex size-10 flex-none items-center justify-center rounded-lg bg-surface text-brand-ink"><svg class="size-5"><use href="#{$fmt->esImagen($a['mime']) ? 'i-image' : 'i-file'}"/></svg></span>
                            <span class="min-w-0"><span class="block truncate text-xs font-semibold">{$a['nombre_original']}</span><span class="block text-[0.6875rem] text-muted">{$fmt->tamano($a['tamano'])}</span></span>
                        </a>
                    </li>
                {/foreach}
            </ul>
        </section>
    {/if}

    {if $conversa}
    <section id="conversacion" class="card card-pad reveal" style="--i:3" aria-labelledby="h-conv">
        <div class="flex items-center justify-between">
            <h2 id="h-conv" class="text-lg font-extrabold tracking-tight">Conversación</h2>
            {if $comentarios}<span class="chip chip-muted">{count($comentarios)}</span>{/if}
        </div>
        {if empty($comentarios)}
            <p class="mt-3 text-sm text-muted">¿Algo que agregar o cambiar? Escríbelo aquí y le llega al equipo.</p>
        {else}
            <ol class="mt-5 space-y-4">
                {foreach $comentarios as $c}
                    {var $mio = $c['autor_tipo'] === 'contacto' && $c['autor_id'] === $contacto['id']}
                    {var $delCliente = $c['autor_tipo'] === 'contacto'}
                    <li class="flex gap-2.5 {$delCliente ? 'flex-row-reverse' : ''}">
                        <span class="avatar size-8! {$delCliente ? '' : 'avatar-team'}">{$fmt->iniciales($c['autor_nombre'])}</span>
                        <div class="max-w-[85%] min-w-0 {$delCliente ? 'text-right' : ''}">
                            <p class="mb-1 text-xs text-muted"><span class="font-semibold text-ink">{$mio ? 'Tú' : $c['autor_nombre']}</span>{if !$delCliente} · Equipo{/if} · {$fmt->rel($c['created_at'])}</p>
                            <div class="bubble inline-block text-left {$delCliente ? 'rounded-tr-md bg-brand-soft text-ink' : 'rounded-tl-md bg-surface2'}">{$c['cuerpo']|breakLines}</div>
                        </div>
                    </li>
                {/foreach}
            </ol>
        {/if}
        <form method="post" action="/portal/solicitudes/{$s['id']}/comentarios" data-once class="mt-5 border-t border-line pt-5">
            <input type="hidden" name="_csrf" value="{$csrf}">
            <label for="nuevo-comentario" class="label">Escribe un comentario</label>
            <textarea id="nuevo-comentario" name="cuerpo" rows="2" maxlength="4000" required data-autogrow class="field" placeholder="Tu mensaje…"></textarea>
            <div class="mt-3 flex justify-end">
                <button type="submit" data-sending="Enviando…" class="btn btn-primary w-full sm:w-auto"><svg class="size-5"><use href="#i-send"/></svg> Enviar</button>
            </div>
        </form>
    </section>
    {/if}
</div>

<aside class="mt-5 lg:mt-0" aria-label="Detalles de la solicitud">
    <div class="card card-pad reveal lg:sticky lg:top-8" style="--i:2">
        <h2 class="text-sm font-extrabold uppercase tracking-wide text-muted">Detalles</h2>
        <dl class="mt-4 space-y-4 text-sm">
            <div><dt class="text-xs text-muted">Proyecto</dt><dd class="mt-0.5 font-semibold">{$s['proyecto_nombre'] ?: 'Proyecto nuevo'}</dd></div>
            <div><dt class="text-xs text-muted">Pedida por</dt><dd class="mt-0.5 font-semibold">{$s['contacto_nombre'] ?: '—'}</dd></div>
            <div><dt class="text-xs text-muted">Enviada</dt><dd class="mt-0.5 font-semibold">{$fmt->fecha($s['created_at'])}</dd></div>
            {if $s['tipo'] !== 'reunion'}<div><dt class="text-xs text-muted">Urgencia</dt><dd class="mt-0.5 font-semibold">{$urgencias[$s['urgencia']] ?? '—'}</dd></div>{/if}
        </dl>
    </div>
</aside>
</div>
{/block}
