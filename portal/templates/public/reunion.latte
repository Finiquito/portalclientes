{layout '_layout.latte'}

{block title}{$r['titulo']}{/block}

{block content}
{var $hora = $fmt->hora($r['fecha'])}
<div class="reveal mb-4">
    <a href="/portal/reuniones" class="inline-flex items-center gap-1.5 text-sm font-semibold text-muted transition hover:text-ink"><svg class="size-4"><use href="#i-back"/></svg> Reuniones</a>
</div>

<div class="mx-auto max-w-3xl">
    <header class="card card-pad reveal">
        <div class="flex items-start gap-4">
            <span class="flex size-16 flex-none flex-col items-center justify-center rounded-2xl leading-none {$proxima ? 'bg-brand text-brand-fg' : 'border-2 border-brand/60 text-brand-ink'}">
                <span class="text-2xl font-extrabold">{$fmt->dia($r['fecha'])}</span>
                <span class="mt-1 text-[0.6875rem] font-bold uppercase tracking-wide">{$fmt->mesCorto($r['fecha'])}</span>
            </span>
            <div class="min-w-0 flex-1">
                <p class="text-xs font-bold uppercase tracking-wide text-muted">{$proxima ? 'Próxima reunión' : 'Reunión'} · {$r['proyecto_nombre']}</p>
                <h1 class="mt-1 text-2xl font-extrabold leading-tight tracking-tight">{$r['titulo']}</h1>
                <p class="mt-1 text-sm text-muted">{$fmt->fechaLarga($r['fecha'])|firstUpper}{if $hora !== ''} · {$hora} (hora de {\TypeDock\Plugin\Portal\HorarioHabil::nombreDe($paisCliente)}){/if}{if $r['duracion_min']} · {$r['duracion_min']} min{/if}</p>
            </div>
        </div>
        {if $proxima && ($r['enlace_meet'] || $hora !== '')}
            <div class="mt-5 flex flex-col gap-2.5 sm:flex-row">
                {if $r['enlace_meet']}<a href="{$r['enlace_meet']}" target="_blank" rel="noopener noreferrer" class="btn btn-primary flex-1 sm:flex-none"><svg class="size-5"><use href="#i-eye"/></svg> Entrar a Google Meet</a>{/if}
                {if $hora !== ''}<a href="/portal/reuniones/{$r['id']}/calendario.ics" class="btn btn-ghost flex-1 sm:flex-none"><svg class="size-5"><use href="#i-calendar"/></svg> Agregar a mi calendario</a>{/if}
            </div>
            {if !$r['enlace_meet']}<p class="mt-3 text-sm text-muted">Todavía no hay link de Meet; te lo enviaremos antes de la reunión.</p>{/if}
        {/if}
    </header>

    {if $verResumen && ($r['resumen'] || $acuerdos)}
    <section class="card card-pad reveal mt-4" style="--i:1" aria-labelledby="h-res">
        <h2 id="h-res" class="text-base font-extrabold tracking-tight">Resumen</h2>
        {if $r['resumen']}<div class="mt-3 text-[0.9375rem] leading-relaxed text-ink/90">{$r['resumen']|breakLines}</div>{/if}
        {if $acuerdos}
            <h3 class="mt-5 text-sm font-extrabold uppercase tracking-wide text-muted">Acuerdos</h3>
            <ul class="mt-2 space-y-2">
                {foreach $acuerdos as $a}
                    <li class="flex gap-2.5 text-[0.9375rem] leading-snug"><svg class="mt-0.5 size-5 flex-none text-ok"><use href="#i-check"/></svg><span>{$a}</span></li>
                {/foreach}
            </ul>
        {/if}
        {if $r['enlace_grabacion']}<a href="{$r['enlace_grabacion']}" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm mt-5"><svg class="size-4"><use href="#i-eye"/></svg> Ver la grabación</a>{/if}
    </section>
    {elseif !$proxima}
    <section class="card card-pad reveal mt-4 text-sm text-muted" style="--i:1">Estamos preparando el resumen de esta reunión. Te avisaremos cuando esté listo.</section>
    {/if}

    {if $tareas}
    <section class="card card-pad reveal mt-4" style="--i:2" aria-labelledby="h-tareas">
        <h2 id="h-tareas" class="text-base font-extrabold tracking-tight">Tareas que salieron de la reunión</h2>
        <ul class="mt-3 divide-y divide-line">
            {foreach $tareas as $t}
                {var $v = $fmt->vence($t['fecha_vencimiento'], $t['estado'])}
                <li>
                    <a href="/portal/tareas/{$t['id']}" class="flex items-center gap-3 py-3 transition hover:opacity-80">
                        <svg class="size-5 flex-none {$t['estado'] === 'hecha' ? 'text-ok' : 'text-muted'}"><use href="#{$t['estado'] === 'hecha' ? 'i-check' : 'i-tasks'}"/></svg>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-semibold {$t['estado'] === 'hecha' ? 'line-through opacity-60' : ''}">{$t['titulo']}</span>
                            <span class="block text-xs text-muted">{$t['responsable_tipo'] === 'cliente' ? 'Te toca a ti' : 'Del equipo'}{if $t['fecha_vencimiento']} · {$v['texto']}{/if}</span>
                        </span>
                        <svg class="size-4 flex-none text-muted"><use href="#i-chevron"/></svg>
                    </a>
                </li>
            {/foreach}
        </ul>
    </section>
    {/if}

    {if $siguiente}
    <a href="/portal/reuniones/{$siguiente['id']}" class="card card-pad reveal mt-4 flex items-center gap-3 transition hover:-translate-y-0.5 hover:shadow-pop" style="--i:3">
        <span class="flex size-11 flex-none items-center justify-center rounded-xl bg-brand-soft text-brand-ink"><svg class="size-5"><use href="#i-calendar"/></svg></span>
        <span class="min-w-0 flex-1"><span class="block text-xs font-bold uppercase tracking-wide text-muted">Próxima reunión</span><span class="block truncate font-bold">{$siguiente['titulo']}</span><span class="block text-xs text-muted">{$fmt->fechaLarga($siguiente['fecha'])|firstUpper} {$fmt->hora($siguiente['fecha'])}</span></span>
        <svg class="size-4 flex-none text-muted"><use href="#i-chevron"/></svg>
    </a>
    {/if}
</div>
{/block}
