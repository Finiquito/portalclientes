{layout '_layout.latte'}

{block title}Inicio{/block}

{block content}
{var $hoyLargo = $fmt->fechaLarga()}

<div class="xl:grid xl:grid-cols-[minmax(0,1fr)_20rem] xl:gap-6">
<div class="min-w-0">

    {* Bienvenida *}
    <section class="relative reveal pb-6 pt-1 sm:pb-8">
        <div class="hero-arcs" aria-hidden="true"></div>
        <p class="relative text-sm font-semibold text-brand-ink">{$hoyLargo|firstUpper}</p>
        <h1 class="relative mt-1 text-[2rem] font-extrabold leading-[1.08] tracking-tight sm:text-5xl">{$fmt->saludo()}, {$nombre}</h1>
        <p class="relative mt-3 max-w-2xl text-base text-muted sm:text-lg">{$frase}</p>
    </section>

    {* Primeros pasos: sólo las primeras veces *}
    {if $pasos}
        {var $hechos = count(array_filter($pasos, fn($p) => $p[2]))}
        <section class="card reveal mb-5 p-4 sm:p-5" aria-labelledby="h-pasos">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <h2 id="h-pasos" class="text-lg font-extrabold tracking-tight">Primeros pasos</h2>
                    <p class="mt-0.5 text-sm text-muted">{_'%d de %d listos. Te toma unos minutos.', $hechos, count($pasos)}</p>
                </div>
                <form method="post" action="/portal/primeros-pasos/ocultar">
                    <input type="hidden" name="_csrf" value="{$csrf}">
                    <button type="submit" class="btn btn-ghost btn-sm">Ya lo entendí</button>
                </form>
            </div>
            <div class="progress mt-3" role="progressbar" aria-valuemin="0" aria-valuemax="{count($pasos)}" aria-valuenow="{$hechos}" aria-label="Avance de primeros pasos"><span style="width: {round($hechos * 100 / count($pasos))|noescape}%"></span></div>
            <ol class="mt-3 space-y-1">
                {foreach $pasos as $p}
                    <li>
                        <a href="{$p[1]}" class="flex items-center gap-3 rounded-xl px-2 py-2 text-sm transition hover:bg-surface2 {$p[2] ? 'text-muted' : 'font-semibold'}">
                            <span class="flex size-6 flex-none items-center justify-center rounded-full {$p[2] ? 'bg-ok text-white' : 'border-2 border-line'}">{if $p[2]}<svg class="size-3.5"><use href="#i-check"/></svg>{/if}</span>
                            <span class="min-w-0 flex-1 {$p[2] ? 'line-through decoration-1' : ''}">{$p[0]}</span>
                            {if !$p[2]}<svg class="size-4 flex-none text-muted"><use href="#i-chevron"/></svg>{/if}
                        </a>
                    </li>
                {/foreach}
            </ol>
        </section>
    {/if}

    {* Accesos rápidos *}
    <section class="grid grid-cols-3 gap-3 sm:gap-4" aria-label="Resumen">
        <a href="/portal/tareas?f=mias" class="card reveal group p-3.5 transition hover:-translate-y-0.5 hover:shadow-pop sm:p-5{if count($meTocan) > 0} kpi-alerta{/if}" style="--i:1">
            <span class="flex size-10 items-center justify-center rounded-xl bg-brand-soft text-brand-ink sm:size-11"><svg class="size-5"><use href="#i-tasks"/></svg></span>
            <span class="mt-3 block text-3xl font-extrabold tracking-tight">{count($meTocan)}</span>
            <span class="block text-xs font-semibold text-muted sm:text-sm">Te toca a ti</span>
        </a>
        <a href="/portal/tareas?f=equipo" class="card reveal group p-3.5 transition hover:-translate-y-0.5 hover:shadow-pop sm:p-5" style="--i:2">
            <span class="flex size-10 items-center justify-center rounded-xl bg-brand-soft text-brand-ink sm:size-11"><svg class="size-5"><use href="#i-eye"/></svg></span>
            <span class="mt-3 block text-3xl font-extrabold tracking-tight">{count($enRevision)}</span>
            <span class="block text-xs font-semibold text-muted sm:text-sm">En revisión</span>
        </a>
        <a href="/portal/archivos" class="card reveal group p-3.5 transition hover:-translate-y-0.5 hover:shadow-pop sm:p-5" style="--i:3">
            <span class="flex size-10 items-center justify-center rounded-xl bg-brand-soft text-brand-ink sm:size-11"><svg class="size-5"><use href="#i-folder"/></svg></span>
            <span class="mt-3 block text-3xl font-extrabold tracking-tight">{$nArchivos}</span>
            <span class="block text-xs font-semibold text-muted sm:text-sm">Archivos</span>
        </a>
    </section>

    {* Evolución de la campaña: aparece cuando lleva 14 días o más recibiendo contactos *}
    {if !empty($campanas)}
        <link rel="stylesheet" href="/plugins/portal/assets/leads.css?v=7">
        {foreach $campanas as $camp}
        <section class="ll ll-graf reveal mt-5" style="--i:4" aria-labelledby="h-camp-{$iterator->counter}">
            <div class="ll-graf-cab">
                <div>
                    <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap"><h2 id="h-camp-{$iterator->counter}">{$camp['nombre']}</h2>{foreach $camp['etiquetas'] as $t}<span class="ll-pub" data-p="{$t}">{$t}</span>{/foreach}</div>
                    <p class="ll-sub">{_'Así van llegando tus contactos'} · {_'%d días de campaña', $camp['dias']}</p>
                </div>
                <a href="/portal/contactos-ganados?proyecto={$camp['id']}" class="text-sm font-semibold text-brand-ink hover:underline">Ver contactos →</a>
            </div>
            {include '../_lead_grafico.latte', grafico: $camp['grafico'], corto: true, botones: false}
            <div class="ll-cifras">
                <div><b>{$camp['total']}</b><span>han llegado{if $camp['nuevosSemana'] > 0} · <em>{_'+%d esta semana', $camp['nuevosSemana']}</em>{/if}</span></div>
                <div><b>{$camp['contactados']}</b><span>ya fueron contactados</span></div>
                <div><b>{$camp['ganados']}</b><span>terminaron en ganado</span></div>
            </div>
        </section>
        {/foreach}
        {include '../_lead_scripts.latte'}
    {/if}

    {* Pedir algo *}
    <section class="card reveal mt-5 flex flex-wrap items-center gap-x-4 gap-y-3 p-4 sm:p-5" style="--i:4" aria-labelledby="h-pedir">
        <span class="flex size-11 flex-none items-center justify-center rounded-xl bg-brand-soft text-brand-ink"><svg class="size-5"><use href="#i-plus"/></svg></span>
        <div class="min-w-0 flex-1">
            <h2 id="h-pedir" class="font-extrabold leading-tight">¿Necesitas algo?</h2>
            <p class="mt-0.5 text-sm text-muted">Pídenos algo nuevo, un presupuesto o una reunión, o avísanos si algo falla.</p>
        </div>
        <div class="flex w-full flex-wrap gap-2 sm:w-auto">
            <a href="/portal/solicitudes/nueva?tipo=pedido" class="btn btn-primary btn-sm flex-1 sm:flex-none">Pedir algo</a>
            <a href="/portal/solicitudes/nueva" class="btn btn-ghost btn-sm flex-1 sm:flex-none">Otras opciones</a>
        </div>
    </section>

    {* Contactos ganados (si el cliente tiene una campaña con el módulo activo) *}
    {if !empty($verLeads)}
    <section class="card reveal mt-5 flex flex-wrap items-center gap-x-4 gap-y-3 p-4 sm:p-5" style="--i:5" aria-labelledby="h-leads">
        <span class="flex size-11 flex-none items-center justify-center rounded-xl bg-brand-soft text-brand-ink"><svg class="size-5"><use href="#i-users"/></svg></span>
        <div class="min-w-0 flex-1">
            <h2 id="h-leads" class="font-extrabold leading-tight">Contactos ganados</h2>
            <p class="mt-0.5 text-sm text-muted">{if $leadsNuevos > 0}{_'Tienes <strong class="text-ink">%d %s</strong> por atender.', $leadsNuevos, $leadsNuevos === 1 ? t('contacto nuevo') : t('contactos nuevos')|noescape}{else}Las personas que llegan por tus campañas, con su seguimiento.{/if}</p>
        </div>
        <a href="/portal/contactos-ganados" class="btn {$leadsNuevos > 0 ? 'btn-primary' : 'btn-ghost'} btn-sm w-full sm:w-auto">Ver contactos</a>
    </section>
    {/if}

    {* Te toca a ti *}
    <section class="card reveal mt-5 overflow-hidden" style="--i:4" aria-labelledby="h-toca">
        <div class="flex items-center justify-between gap-3 px-5 pb-2 pt-5 sm:px-6 sm:pt-6">
            <h2 id="h-toca" class="text-lg font-extrabold tracking-tight">Te toca a ti</h2>
            {if count($meTocan) > 0}<span class="chip chip-brand">{count($meTocan)} {count($meTocan) === 1 ? t('pendiente') : t('pendientes')}</span>{/if}
        </div>

        {if empty($meTocan)}
            <div class="flex flex-col items-center px-6 pb-9 pt-5 text-center">
                <span class="flex size-14 items-center justify-center rounded-2xl bg-ok/10 text-ok"><svg class="size-7"><use href="#i-check"/></svg></span>
                <p class="mt-4 font-bold">Estás al día</p>
                <p class="mt-1 max-w-xs text-sm text-muted">Cuando necesitemos algo de ti, un archivo, una respuesta o una aprobación, aparecerá aquí.</p>
            </div>
        {else}
            <ul class="px-2 pb-2 sm:px-3 sm:pb-3">
                {foreach $meTocan as $t}
                    {var $v = $fmt->vence($t['fecha_vencimiento'], $t['estado'])}
                    <li>
                        <a href="/portal/tareas/{$t['id']}" class="group flex items-center gap-3 rounded-2xl p-3 transition hover:bg-surface2 sm:p-3.5">
                            <span class="flex size-11 flex-none items-center justify-center rounded-xl bg-brand-soft text-brand-ink">
                                <svg class="size-5"><use href="#{$t['tipo'] === 'archivo' ? 'i-upload' : ($t['tipo'] === 'revision' ? 'i-eye' : 'i-tasks')}"/></svg>
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate font-semibold">{$t['titulo']}</span>
                                <span class="mt-0.5 block truncate text-xs text-muted">{$fmt->tipo($t['tipo'])}{if $multiples} · <span class="inline-flex items-center gap-1.5 align-middle"><span aria-hidden="true" style="display:inline-block;width:.6rem;height:.6rem;border-radius:9999px;flex:none;background:{($colorProy[$t['proyecto_id']] ?? '#94a3b8')|noescape}"></span>{$t['proyecto_nombre']}</span>{/if}</span>
                            </span>
                            <span class="chip chip-{$v['tono']} hidden sm:inline-flex">{$v['texto']}</span>
                            <svg class="size-4 flex-none text-muted transition group-hover:translate-x-0.5"><use href="#i-chevron"/></svg>
                        </a>
                        <span class="chip chip-{$v['tono']} -mt-1 mb-2 ml-[4.5rem] sm:hidden">{$v['texto']}</span>
                    </li>
                {/foreach}
            </ul>
        {/if}
    </section>

    {* Avance de cada proyecto *}
    {if $tusProyectos}
    <link rel="stylesheet" href="/plugins/portal/assets/panel.css?v=5">
    <section class="card card-pad reveal mt-5" style="--i:5" aria-labelledby="h-avance">
        <h2 id="h-avance" class="text-lg font-extrabold tracking-tight">{count($tusProyectos) === 1 ? 'Tu proyecto' : 'Tus proyectos'}</h2>
        <p class="mt-0.5 text-sm text-muted">{count($tusProyectos) === 1 ? t('Cómo va, de un vistazo') : t('Cómo va cada uno, de un vistazo')}</p>
        <div class="pc-g">
            {foreach $tusProyectos as $i => $tp}
                {var $destaca = $i === 0 && ($tp['me_tocan'] + $tp['revisar']) > 0}
                <article class="pc{if $destaca} bloque-azul{/if}">
                    <div class="flex items-start justify-between gap-3">
                        <h3><i style="background: {($colorProy[$tp['id']] ?? '#94a3b8')|noescape}" aria-hidden="true"></i><span class="min-w-0">{$tp['nombre']}</span></h3>
                        <span class="pc-pct">{$tp['pct']}<small>%</small></span>
                    </div>
                    {if $tp['fases']}
                        <div class="pc-seg" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{$tp['pct']}" aria-label="Avance">
                            {foreach $tp['fases'] as $f}<i class="{$f['estado'] === 'hecha' ? 'h' : ($f['estado'] === 'actual' ? 'a' : '')}" title="{$f['nombre']}"></i>{/foreach}
                        </div>
                    {else}
                        <div class="progress mt-3" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{$tp['pct']}" aria-label="Avance"><span style="width: {$tp['pct']}%"></span></div>
                    {/if}
                    <p class="pc-fase mt-2">
                        {if $tp['completo']}<b>Proyecto completo</b>
                        {elseif $tp['actual']}{_'Etapa'} <b>{_'%d de %d', $tp['actual']['n'], count($tp['fases'])} · {$tp['actual']['nombre']}</b>{if $tp['sigue']} · {if $tp['sigue']['inicio']}{_'sigue %s el %s', $tp['sigue']['nombre'], $fmt->fechaCorta($tp['sigue']['inicio'])}{else}{_'sigue %s', $tp['sigue']['nombre']}{/if}{/if}
                        {else}{$tp['pct'] === 0 ? t('Todavía no empieza') : t('En marcha')}{/if}
                    </p>
                    <div class="pc-tips">
                        {if $tp['me_tocan'] > 0}<span class="pc-tip t1" style="{$destaca ? '' : 'color: var(--warn)'}">{$tp['me_tocan'] === 1 ? t('1 cosa te toca a ti') : t('%d cosas te tocan a ti', $tp['me_tocan'])}</span>{/if}
                        {if $tp['revisar'] > 0}<span class="pc-tip" style="{$destaca ? '' : 'color: var(--brand-ink)'}">{$tp['revisar'] === 1 ? t('1 pieza para revisar') : t('%d piezas para revisar', $tp['revisar'])}</span>{/if}
                        {if $tp['me_tocan'] === 0 && $tp['revisar'] === 0}<span class="pc-tip" style="color: var(--muted)">Nada te toca por ahora</span>{/if}
                    </div>
                    <div class="pc-pie">
                        <span>{if $tp['fechas']['fin']}Entrega estimada <b>{$fmt->fechaCorta($tp['fechas']['fin'])}</b>{/if}{if $tp['reunion']}{if $tp['fechas']['fin']} · {/if}próxima reunión <b>{$fmt->fechaCorta($tp['reunion']['fecha'])}</b>{/if}</span>
                        <a href="/portal/calendario?proyecto={$tp['id']}">Ver proyecto →</a>
                    </div>
                </article>
            {/foreach}

            {if $contactosSemanal}
                {var $cg = $contactosSemanal['datos']}
                {var $mx = max(1, ...array_column($cg['semanas'], 'llegaron'))}
                <article class="pc" style="grid-column: 1 / -1; background: var(--surface-2)">
                    <h3>Contactos ganados{if $contactosSemanal['nombre'] !== ''} · <span class="min-w-0 font-semibold text-muted">{$contactosSemanal['nombre']}</span>{/if}</h3>
                    <p class="pc-fase" style="margin:.35rem 0 1rem"><b>{$cg['total']['llegaron']}</b> {$cg['total']['llegaron'] === 1 ? t('contacto') : t('contactos')} · <b>{$cg['total']['contactados']}</b> {$cg['total']['contactados'] === 1 ? t('contactado') : t('contactados')} · <b>{$cg['total']['ganado']}</b> {$cg['total']['ganado'] === 1 ? t('ganado') : t('ganados')}</p>
                    {include '../_lead_semanal.latte', cg: $cg, mx: $mx, fmt: $fmt}
                    <div class="pc-pie"><span></span><a href="/portal/contactos-ganados">Ver contactos →</a></div>
                </article>
            {/if}
        </div>
    </section>
    {/if}

</div>

{* Columna lateral *}
<aside class="mt-5 min-w-0 space-y-5 xl:mt-0 aside-nivelada" aria-label="Novedades">

    <section class="card card-pad reveal" style="--i:4">
        <div class="flex items-center justify-between">
            <h2 class="text-base font-extrabold tracking-tight">Próximas reuniones</h2>
            <a href="/portal/reuniones" class="text-xs font-semibold text-brand-ink hover:underline">Ver todas</a>
        </div>
        {if empty($reuniones)}
            <p class="mt-3 text-sm text-muted">No hay reuniones agendadas por ahora.</p>
        {else}
            <ul class="mt-4 space-y-3">
                {foreach $reuniones as $r}
                    <li><a href="/portal/reuniones/{$r['id']}" class="flex items-center gap-3 rounded-xl transition hover:opacity-80">
                        <span class="flex size-12 flex-none flex-col items-center justify-center rounded-xl bg-brand-soft leading-none text-brand-ink">
                            <span class="text-lg font-extrabold">{$fmt->dia($r['fecha'])}</span>
                            <span class="mt-0.5 text-[0.625rem] font-bold uppercase tracking-wide">{$fmt->mesCorto($r['fecha'])}</span>
                        </span>
                        <span class="min-w-0">
                            <span class="block truncate text-sm font-semibold">{$r['titulo']}</span>
                            <span class="block truncate text-xs text-muted">{$fmt->hora($r['fecha'])}{if $fmt->hora($r['fecha']) !== ''} · {/if}{$r['proyecto_nombre']}</span>
                            {if $r['enlace_meet']}<span class="mt-0.5 block text-xs font-bold text-brand-ink">Con link de Meet</span>{/if}
                        </span>
                    </a></li>
                {/foreach}
            </ul>
        {/if}
    </section>

    <section class="card card-pad reveal bloque-azul" style="--i:5">
        <h2 class="text-base font-extrabold tracking-tight">Novedades</h2>
        {if empty($novedades)}
            <p class="mt-3 text-sm text-muted">Aquí verás lo que vaya pasando en tu proyecto: comentarios, archivos y aprobaciones.</p>
        {else}
            {foreach $novedades as $sec => $items}
                <h3 class="{$iterator->first ? 'mt-3' : 'mt-5'} text-xs font-bold uppercase tracking-wide text-muted">{$seccionesN[$sec]}</h3>
                <ul class="mt-1.5 space-y-0.5">
                    {foreach $items as $n}
                        <li>
                            <a {if $n['url']}href="{$n['url']}"{/if} class="group -mx-2 block rounded-xl px-2 py-2 transition {$n['url'] ? 'hover:bg-surface2' : ''}">
                                <span class="flex items-start gap-2">
                                    <span class="mt-[0.4rem] size-2 flex-none rounded-full {$n['nueva'] ? 'bg-brand' : 'bg-transparent'}" {if $n['nueva']}title="Nuevo desde tu última visita"{/if} aria-hidden="true"></span>
                                    <span class="min-w-0 flex-1">
                                        <span class="block text-sm font-semibold leading-snug">{$n['titulo'] ?: t('Sin título')}{if $n['nueva']}<span class="sr-only"> (nuevo)</span>{/if}</span>
                                        <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
                                            {if $n['estado']}<span class="chip chip-{$n['estado'][1]}">{$n['estado'][0]}</span>{/if}
                                            {if $n['resumen']}<span>{$n['resumen']}</span>{/if}
                                            <span>{$fmt->rel($n['fecha'])}</span>
                                        </span>
                                    </span>
                                </span>
                            </a>
                        </li>
                    {/foreach}
                </ul>
            {/foreach}
        {/if}
    </section>
</aside>
</div>
{/block}
