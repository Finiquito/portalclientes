{layout '_layout.latte'}

{block title}Archivos{/block}

{block content}
<header class="reveal pb-5 pt-1">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Archivos</h1>
    <p class="mt-1.5 text-muted">Todo lo que hemos compartido y lo que has subido, en un solo lugar.</p>
</header>

{var $grupos = [
    ['Que te enviamos', $delEquipo, 'Aquí aparecerán las piezas y documentos que te compartamos.'],
    ['Que subiste tú',  $tuyos,     'Cuando subas archivos en una tarea, los verás aquí.'],
]}

{foreach $grupos as $i => $g}
<section class="card card-pad reveal mb-5" style="--i:{$i + 1}">
    <div class="flex items-center justify-between">
        <h2 class="text-lg font-extrabold tracking-tight">{$g[0]}</h2>
        {if $g[1]}<span class="chip chip-muted">{count($g[1])}</span>{/if}
    </div>

    {if empty($g[1])}
        <p class="mt-3 text-sm text-muted">{$g[2]}</p>
    {else}
        <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
            {foreach $g[1] as $a}
                <li class="min-w-0">
                    {if $fmt->esImagen($a['mime'])}
                        <a href="/portal/archivo/{$a['id']}?i=1" target="_blank" rel="noopener" class="group block overflow-hidden rounded-xl border border-line bg-surface2">
                            <img src="/portal/archivo/{$a['id']}?t=1&i=1" loading="lazy" alt="{$a['nombre_original']}" class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:scale-[1.03]">
                            <span class="block bg-surface px-3 py-2 text-xs"><span class="block truncate font-semibold">{$a['nombre_original']}</span><span class="text-muted">{$fmt->tamano($a['tamano'])} · {$fmt->fecha($a['created_at'])}</span></span>
                        </a>
                    {else}
                        <a href="/portal/archivo/{$a['id']}{if $a['mime'] === 'application/pdf'}?i=1{/if}" {if $a['mime'] === 'application/pdf'}target="_blank" rel="noopener"{/if} class="flex h-full min-h-[8.5rem] flex-col justify-between gap-3 rounded-xl border border-line bg-surface2 p-3 transition hover:border-brand/50">
                            <span class="flex size-10 items-center justify-center rounded-lg bg-surface text-brand-ink"><svg class="size-5"><use href="#i-file"/></svg></span>
                            <span class="min-w-0">
                                <span class="block truncate text-xs font-semibold">{$a['nombre_original']}</span>
                                <span class="mt-0.5 block text-[0.6875rem] text-muted">{$fmt->extension($a['nombre_original'])|upper} · {$fmt->tamano($a['tamano'])} · {$fmt->fecha($a['created_at'])}</span>
                            </span>
                        </a>
                    {/if}
                    <a href="/portal/tareas/{$a['tarea_id']}" class="mt-1.5 flex items-center gap-1 truncate px-1 text-xs font-semibold text-brand-ink hover:underline"><svg class="size-3.5 flex-none"><use href="#i-tasks"/></svg><span class="truncate">{$a['tarea_titulo']}</span></a>
                </li>
            {/foreach}
        </ul>
    {/if}
</section>
{/foreach}
{/block}
