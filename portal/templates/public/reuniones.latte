{layout '_layout.latte'}

{block title}Reuniones{/block}

{block content}
<header class="reveal pb-5 pt-1">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Reuniones</h1>
    <p class="mt-1.5 text-muted">Lo que viene y el resumen de lo que hemos conversado.</p>
</header>

{var $bloques = [
    ['Próximas',   $proximas,   true,  'No hay reuniones agendadas por ahora.'],
    ['Anteriores', $anteriores, false, 'Todavía no hay reuniones anteriores.'],
]}

{foreach $bloques as $i => $b}
<section class="mb-6">
    <h2 class="reveal mb-3 text-sm font-extrabold uppercase tracking-wide text-muted" style="--i:{$i}">{$b[0]}</h2>
    {if empty($b[1])}
        <div class="card card-pad reveal text-sm text-muted" style="--i:{$i + 1}">{$b[3]}</div>
    {else}
        <ul class="space-y-3">
            {foreach $b[1] as $j => $r}
                <li class="card card-pad reveal flex gap-4" style="--i:{$j + 1}">
                    <span class="flex size-14 flex-none flex-col items-center justify-center rounded-2xl leading-none {$b[2] ? 'bg-brand text-brand-fg' : 'bg-surface2 text-muted'}">
                        <span class="text-xl font-extrabold">{$fmt->dia($r['fecha'])}</span>
                        <span class="mt-1 text-[0.6875rem] font-bold uppercase tracking-wide">{$fmt->mesCorto($r['fecha'])}</span>
                    </span>
                    <div class="min-w-0 flex-1">
                        <h3 class="font-bold leading-snug"><a href="/portal/reuniones/{$r['id']}" class="hover:underline">{$r['titulo']}</a></h3>
                        <p class="mt-0.5 text-xs text-muted">{$fmt->hora($r['fecha'])}{if $fmt->hora($r['fecha']) !== ''} · {/if}<span class="inline-flex items-center gap-1.5 align-middle"><span aria-hidden="true" style="display:inline-block;width:.6rem;height:.6rem;border-radius:9999px;flex:none;background:{($colorProy[$r['proyecto_id']] ?? '#94a3b8')|noescape}"></span>{$r['proyecto_nombre']}</span></p>
                        {if $b[2] && $r['enlace_meet']}<a href="{$r['enlace_meet']}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm mt-3"><svg class="size-4"><use href="#i-eye"/></svg> Entrar a Meet</a>{/if}
                        {if $r['resumen_publicado'] && $r['resumen']}<div class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink/85">{$r['resumen']|breakLines}</div>{/if}
                        <a href="/portal/reuniones/{$r['id']}" class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-brand-ink hover:underline">{$b[2] ? 'Ver detalle' : 'Ver resumen y tareas'} <svg class="size-3.5"><use href="#i-chevron"/></svg></a>
                    </div>
                </li>
            {/foreach}
        </ul>
    {/if}
</section>
{/foreach}
{/block}
