{layout '_layout.latte'}

{block title}Solicitudes{/block}

{block content}
<header class="reveal flex flex-wrap items-end justify-between gap-4 pb-5 pt-1">
    <div>
        <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Solicitudes</h1>
        <p class="mt-1.5 text-muted">Pídenos algo nuevo, un presupuesto o una reunión, o avísanos si algo falla.</p>
    </div>
</header>

{* Qué necesitas: los cuatro tipos *}
<section class="reveal grid grid-cols-2 gap-3 sm:gap-4 xl:grid-cols-4" style="--i:1" aria-label="Nueva solicitud">
    {foreach $tipos as $k => $t}
        <a href="/portal/solicitudes/nueva?tipo={$k}" class="card group flex flex-col p-4 transition hover:-translate-y-0.5 hover:shadow-pop sm:p-5">
            <span class="flex size-11 items-center justify-center rounded-xl {$k === 'problema' ? 'bg-danger/10 text-danger' : 'bg-brand-soft text-brand-ink'}"><svg class="size-5"><use href="#{$t[2]}"/></svg></span>
            <span class="mt-3 font-extrabold leading-tight">{$t[0]}</span>
            <span class="mt-1 text-sm leading-snug text-muted">{$t[1]}</span>
        </a>
    {/foreach}
</section>

{foreach [['Abiertas', $abiertas, 'Nada abierto por ahora. Cuando nos pidas algo, aquí ves en qué va.'], ['Cerradas', $cerradas, '']] as $g}
{if $g[1] || $iterator->first}
<section class="card reveal mt-5 overflow-hidden" style="--i:{2 + $iterator->counter}" aria-label="{$g[0]}">
    <h2 class="px-5 pb-1 pt-5 text-lg font-extrabold tracking-tight sm:px-6">{$g[0]}</h2>
    {if empty($g[1])}
        <p class="px-5 pb-6 pt-1 text-sm text-muted sm:px-6">{$g[2]}</p>
    {else}
        <ul class="divide-y divide-line/70 p-1.5 sm:p-2">
            {foreach $g[1] as $s}
                {var $e = $estadosS[$s['estado']] ?? ['—', 'muted']}
                {if $s['estado'] === 'en_curso' && $s['tarea_estado'] === 'hecha'}{var $e = ['Lista', 'ok']}{/if}
                <li>
                    <a href="/portal/solicitudes/{$s['id']}" class="group flex items-center gap-3 rounded-2xl p-3 transition hover:bg-surface2 sm:p-3.5">
                        <span class="flex size-11 flex-none items-center justify-center rounded-xl {$s['tipo'] === 'problema' ? 'bg-danger/10 text-danger' : 'bg-brand-soft text-brand-ink'}"><svg class="size-5"><use href="#{$tipos[$s['tipo']][2]}"/></svg></span>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate font-semibold">{$s['titulo']}</span>
                            <span class="mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-xs text-muted">
                                <span>{$tipos[$s['tipo']][0]}</span>
                                {if $multiples}<span class="inline-flex items-center gap-1.5 font-semibold"><span aria-hidden="true" style="display:inline-block;width:.6rem;height:.6rem;border-radius:9999px;flex:none;background:{($colorProy[$s['proyecto_id']] ?? '#94a3b8')|noescape}"></span>{$s['proyecto_nombre'] ?: 'Proyecto nuevo'}</span>{/if}
                                {if $s['urgencia'] === 'urgente'}<span class="font-bold text-danger">Urgente</span>{/if}
                                <span>{$fmt->rel($s['created_at'])}</span>
                                {if $s['n_comentarios'] > 0}<span class="inline-flex items-center gap-1"><svg class="size-3.5"><use href="#i-chat"/></svg>{$s['n_comentarios']}</span>{/if}
                            </span>
                        </span>
                        <span class="chip chip-{$e[1]} hidden sm:inline-flex">{$e[0]}</span>
                        <svg class="size-4 flex-none text-muted transition group-hover:translate-x-0.5"><use href="#i-chevron"/></svg>
                    </a>
                    <span class="chip chip-{$e[1]} -mt-1 mb-2.5 ml-[4.5rem] sm:hidden">{$e[0]}</span>
                </li>
            {/foreach}
        </ul>
    {/if}
</section>
{/if}
{/foreach}
{/block}
