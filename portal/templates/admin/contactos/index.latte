{layout $plugin_ui_layout}

{block page_title}Contactos{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/portal-admin.css?v=7">
<div class="page-header">
    <h1>Contactos de clientes</h1>
    <a href="{$admin_url('contactos/nuevo')}" class="btn btn-primary">Nuevo contacto</a>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

{if empty($contactos)}
    <div class="card"><p class="text-slate-500">Todavía no hay contactos. Estos son las personas del cliente que van a poder entrar al portal.</p></div>
{else}
<div class="card">
    <table class="table">
        <thead><tr><th>Nombre</th><th>Cliente</th><th>Email</th><th>Rol</th><th>Portal</th><th></th></tr></thead>
        <tbody>
        {foreach $contactos as $c}
            <tr>
                <td><a href="{$admin_url('contactos/' . $c['id'])}">{$c['nombre']}</a></td>
                <td>{$c['cliente_nombre']}</td>
                <td>{$c['email']}</td>
                <td>{$c['rol'] === 'aprobador' ? 'Colaborador' : 'Sólo lectura'}</td>
                <td>
                    {if $c['primer_acceso']}<span class="pa-chip ok">Entró</span> <span class="pa-muted">{$fmt->rel($c['ultimo_acceso'])}</span>
                    {elseif $c['invitado_en']}<span class="pa-chip warn">Invitado</span> <span class="pa-muted">{$fmt->rel($c['invitado_en'])}, aún no entra</span>
                    {else}<a href="{$admin_url('contactos/' . $c['id'])}" class="pa-chip gris">Sin invitar</a>{/if}
                </td>
                <td style="white-space:nowrap">
                    <form method="post" action="{isset($enPanel) ? '/equipo/ver-como/' . $c['id'] : $admin_url('contactos/' . $c['id'] . '/ver-como')}" style="display:inline">
                        <input type="hidden" name="{isset($enPanel) ? '_csrf' : '_csrf_token'}" value="{$csrf_token}">
                        <button type="submit" class="btn btn-sm" title="Abre su portal en modo de sólo lectura">Ver como</button>
                    </form>
                    <form method="post" action="{$admin_url('contactos/' . $c['id'] . '/borrar')}" style="display:inline" onsubmit="return confirm('¿Eliminar este contacto? Ya no podrá entrar al portal.');">
                        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        {/foreach}
        </tbody>
    </table>
</div>
{/if}
