{layout $plugin_ui_layout}

{block page_title}Plantillas de proyecto{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/portal-admin.css?v=9">
<div class="page-header">
    <div style="display:block">
        <h1>Plantillas de proyecto</h1>
        <p class="pa-muted" style="margin:.2rem 0 0">Fases, tareas e hitos listos para armar un proyecto en un paso.</p>
    </div>
    <a href="{$admin_url('proyectos')}" class="btn">Volver a proyectos</a>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

<div class="card">
    <p class="pa-muted" style="margin:0"><strong>Cómo se usan:</strong> en la línea de tiempo de un proyecto sin fechas, o al crear un proyecto, eliges la plantilla y la fecha de inicio. <strong>Para crear una propia:</strong> arma (o ajusta) un proyecto como te gusta y, en su línea de tiempo, usa «Guardar como plantilla».</p>
</div>

{if !$plantillas}
    <div class="card"><p class="pa-muted">No hay plantillas.</p></div>
{/if}

{foreach $plantillas as $pl}
<div class="card pa-plantilla">
    <div class="pa-plantilla-cab">
        <div>
            <h2 class="pa-h2" style="margin:0">{$pl['nombre']}</h2>
            {if $pl['descripcion']}<p class="pa-muted" style="margin:.2rem 0 0">{$pl['descripcion']}</p>{/if}
            <p class="pa-muted" style="margin:.35rem 0 0">{count($pl['e']['fases'])} fases · {count($pl['e']['tareas'])} tareas · {count($pl['e']['hitos'])} hitos · unos {\TypeDock\Plugin\Portal\PlantillaService::diasTotales($pl['e'])} días hábiles</p>
        </div>
        <div class="pa-row">
            <details class="pa-mas">
                <summary>Renombrar</summary>
                <form method="post" action="{$admin_url('plantillas/' . $pl['id'])}" class="pa-stack" style="margin-top:.5rem; min-width:16rem">
                    <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                    <input type="text" name="nombre" class="form-input" value="{$pl['nombre']}" required maxlength="255">
                    <input type="text" name="descripcion" class="form-input" value="{$pl['descripcion']}" maxlength="500" placeholder="Descripción (opcional)">
                    <button type="submit" class="btn btn-sm btn-primary">Guardar</button>
                </form>
            </details>
            <form method="post" action="{$admin_url('plantillas/' . $pl['id'] . '/borrar')}" onsubmit="return confirm('¿Eliminar la plantilla «{$pl['nombre']}»? Los proyectos que se armaron con ella no cambian.');">
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
            </form>
        </div>
    </div>
    <div class="pa-plantilla-fases">
        {foreach $pl['e']['fases'] as $i => $f}
            <section>
                <h3>{$i + 1}. {$f['nombre']}</h3>
                <ul>
                    {foreach $pl['e']['tareas'] as $t}
                        {if ($t['fase'] ?? null) === $i}
                        <li class="quien-{$t['quien'] ?? 'equipo'}"><span>{$t['titulo']}</span><small>{$t['dias']} {$t['dias'] == 1 ? 'día' : 'días'}</small></li>
                        {/if}
                    {/foreach}
                    {foreach $pl['e']['hitos'] as $h}
                        {if ($h['fase'] ?? null) === $i}<li class="hito"><span>◆ {$h['nombre']}</span><small>al terminar</small></li>{/if}
                    {/foreach}
                </ul>
            </section>
        {/foreach}
    </div>
</div>
{/foreach}
{/block}
