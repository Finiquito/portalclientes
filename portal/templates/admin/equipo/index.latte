{layout $plugin_ui_layout}

{block page_title}Equipo{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/portal-admin.css?v=4">

<div class="page-header">
    <h1>Equipo de agencia</h1>
    <a href="{$admin_url('equipo/nuevo')}" class="btn btn-primary">Nueva persona</a>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

<p class="pa-muted">Personas de la agencia que entran al panel con su correo y un código (sin contraseña). Cada una ve solo los clientes o proyectos que le asignes, salvo «Coordinación», que ve todo.</p>

{if empty($usuarios)}
    <div class="card mt-3"><p class="pa-muted">Todavía no hay personas en el equipo. Crea la primera y asígnale clientes.</p></div>
{else}
<div class="card mt-3">
    <table class="table">
        <thead><tr><th>Nombre</th><th>Rol</th><th>Ve</th><th>Último acceso</th><th></th></tr></thead>
        <tbody>
        {foreach $usuarios as $u}
            <tr{if !(int) $u['activo']} class="pa-archivada"{/if}>
                <td><a href="{$admin_url('equipo/' . $u['id'])}"><strong>{$u['nombre']}</strong></a><br><span class="pa-muted">{$u['cargo'] ? $u['cargo'] . ' · ' : ''}{$u['email']}</span></td>
                <td><span class="pa-chip {$u['rol'] === 'coordinador' ? 'brand' : ''}">{$u['rol'] === 'coordinador' ? 'Coordinación' : 'Equipo'}</span>{if !(int) $u['activo']} <span class="pa-chip">Inactiva</span>{/if}</td>
                <td>{if $u['rol'] === 'coordinador'}Todos los clientes{elseif isset($ve[$u['id']])}{$ve[$u['id']]}{else}<span class="pa-muted">Nada asignado</span>{/if}</td>
                <td>{if $u['ultimo_acceso']}{$fmt->rel($u['ultimo_acceso'])}{else}<span class="pa-muted">Nunca</span>{/if}</td>
                <td><a href="{$admin_url('equipo/' . $u['id'])}" class="btn btn-sm">Editar</a></td>
            </tr>
        {/foreach}
        </tbody>
    </table>
</div>
{/if}
{/block}
