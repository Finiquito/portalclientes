{layout $plugin_ui_layout}

{block page_title}{if $persona}{$persona['nombre']}{else}Nueva persona{/if}{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/portal-admin.css?v=7">

<div class="page-header">
    <h1>{if $persona}{$persona['nombre']}{else}Nueva persona del equipo{/if}</h1>
    <a href="{$admin_url('equipo')}" class="btn">Volver</a>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

<form method="post" action="{if $persona}{$admin_url('equipo/' . $persona['id'])}{else}{$admin_url('equipo')}{/if}" id="form-equipo">
<input type="hidden" name="_csrf_token" value="{$csrf_token}">
<div class="card">
    <div class="pa-grid-2">
        <div>
            <label class="form-label">Nombre</label>
            <input type="text" name="nombre" class="form-input" value="{$persona['nombre'] ?? ''}" required maxlength="255">
        </div>
        <div>
            <label class="form-label">Correo (con esto entra al panel)</label>
            <input type="email" name="email" class="form-input" value="{$persona['email'] ?? ''}" required>
        </div>
        <div>
            <label class="form-label">Cargo <span class="pa-muted">(opcional)</span></label>
            <input type="text" name="cargo" class="form-input" value="{$persona['cargo'] ?? ''}" maxlength="120" placeholder="Ej.: Diseñadora, Community manager">
        </div>
        <div>
            <label class="form-label">Rol</label>
            {var $rolActual = $persona['rol'] ?? 'equipo'}
            <select name="rol" class="form-input" id="rol">
                {foreach $roles as $k => $txt}
                    <option value="{$k}" {if $rolActual === $k}selected{/if}>{$txt}</option>
                {/foreach}
            </select>
        </div>
    </div>
    <label class="pa-check"><input type="checkbox" name="activo" value="1" {if !$persona || (int) $persona['activo']}checked{/if}> <span>Activa (puede entrar al panel). Si la desactivas, sus comentarios y tareas se conservan.</span></label>
    {if !$persona}
    <label class="pa-check"><input type="checkbox" name="invitar" value="1" checked> <span>Enviarle ahora un correo con el acceso al panel</span></label>
    {/if}
</div>

<div class="card mt-4" id="asignaciones">
    <h2 class="pa-h2">Clientes y proyectos que ve</h2>
    <p class="pa-muted" id="hint-coord">Marca el cliente completo (incluye los proyectos que se creen después) o solo algunos proyectos.</p>
    {if empty($arbol)}
        <p class="pa-muted">Todavía no hay clientes.</p>
    {else}
    <div class="pa-grid-2 mt-3">
        {foreach $arbol as $c}
        {var $full = in_array($c['id'], $clientesFull, true)}
        <div class="pa-file" data-cliente>
            <div class="pa-meta">
                <label class="pa-check" style="margin-top:0"><input type="checkbox" name="clientes[]" value="{$c['id']}" {if $full}checked{/if} data-full> <span><strong>{$c['nombre']}</strong> <span class="pa-muted">· cliente completo</span></span></label>
                {foreach $c['proyectos'] as $p}
                <label class="pa-check" style="margin:.35rem 0 0 1.6rem"><input type="checkbox" name="proyectos[]" value="{$p['id']}" {if $full || in_array($p['id'], $proyAsig, true)}checked{/if} data-proy> <span>{$p['nombre']}{if $p['estado'] !== 'activo'} <span class="pa-muted">({$p['estado']})</span>{/if}</span></label>
                {else}
                <p class="pa-muted" style="margin:.35rem 0 0 1.6rem">Sin proyectos</p>
                {/foreach}
            </div>
        </div>
        {/foreach}
    </div>
    {/if}
</div>

<p class="mt-4"><button type="submit" class="btn btn-primary">Guardar</button></p>
</form>

{if $persona}
<div class="card mt-4">
    <div class="pa-row">
        <form method="post" action="{$admin_url('equipo/' . $persona['id'] . '/invitar')}">
            <input type="hidden" name="_csrf_token" value="{$csrf_token}">
            <button type="submit" class="btn">Reenviar invitación</button>
        </form>
        <span class="pa-muted">Le llega un correo con el enlace al panel. Para entrar siempre pide un código a su correo.</span>
    </div>
    <hr class="pa-hr">
    <form method="post" action="{$admin_url('equipo/' . $persona['id'] . '/borrar')}" onsubmit="return confirm('¿Eliminar a {$persona['nombre']}? Ya no podrá entrar. Sus comentarios y tareas se conservan. Si solo quieres quitarle el acceso por un tiempo, desactívala.');">
        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
        <button type="submit" class="btn btn-danger">Eliminar del equipo</button>
    </form>
</div>
{/if}

<script>
(function () {
  var rol = document.getElementById('rol'), caja = document.getElementById('asignaciones');
  function sync() {
    var coord = rol.value === 'coordinador';
    caja.style.opacity = coord ? '.5' : '';
    document.getElementById('hint-coord').textContent = coord
      ? 'Coordinación ve todos los clientes: las asignaciones no aplican mientras tenga este rol.'
      : 'Marca el cliente completo (incluye los proyectos que se creen después) o solo algunos proyectos.';
    document.querySelectorAll('[data-cliente]').forEach(function (c) {
      var full = c.querySelector('[data-full]').checked;
      c.querySelectorAll('[data-proy]').forEach(function (p) { if (full) p.checked = true; p.disabled = full; });
    });
  }
  rol.addEventListener('change', sync);
  document.querySelectorAll('[data-full]').forEach(function (f) { f.addEventListener('change', sync); });
  sync();
})();
</script>
{/block}
