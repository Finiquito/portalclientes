{layout $plugin_ui_layout}

{block page_title}{if $entrega}{$entrega['titulo']}{else}Nueva entrega{/if}{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/portal-admin.css?v=15">

<div class="page-header">
    <h1>{if $entrega}Entrega: {$entrega['titulo']}{else}Nueva entrega{/if}</h1>
    <a href="{$admin_url('entregas')}" class="btn">Volver</a>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

<div class="card">
    <form method="post" action="{if $entrega}{$admin_url('entregas/' . $entrega['id'])}{else}{$admin_url('entregas')}{/if}"{if !$entrega} enctype="multipart/form-data"{/if}>
        <input type="hidden" name="_csrf_token" value="{$csrf_token}">

        {if !$entrega}
        <label class="form-label">Proyecto</label>
        <select name="proyecto_id" class="form-input" required>
            {foreach $proyectos as $p}
                <option value="{$p['id']}" {if ($pre['proyecto_id'] ?? '') === $p['id']}selected{/if}>{$p['cliente_nombre']} · {$p['nombre']}</option>
            {/foreach}
        </select>
        {else}
        <p class="pa-muted">{$entrega['cliente_nombre']} · {$entrega['proyecto_nombre']}</p>
        {/if}

        <label class="form-label mt-3">Título</label>
        <input type="text" name="titulo" class="form-input" value="{$entrega['titulo'] ?? ''}" {if $entrega}required{/if} maxlength="255" placeholder="Ej.: Grilla de octubre · Instagram">
        {if !$entrega}<p class="form-hint mt-1">Si subes una planilla abajo, puedes dejarlo vacío: usa el nombre del archivo.</p>{/if}

        <label class="form-label mt-3">Mensaje para el cliente (opcional)</label>
        <textarea name="mensaje" class="form-input" rows="3" placeholder="Contexto de lo que va a revisar, qué necesitas de él, etc.">{$entrega['mensaje'] ?? ''}</textarea>

        <label class="form-label mt-3">Fecha límite de respuesta</label>
        <input type="date" name="fecha_limite" class="form-input" value="{if $entrega && $entrega['fecha_limite']}{substr($entrega['fecha_limite'], 0, 10)}{/if}">
        {include '../_fase_campo.latte', fasesRango: $fasesRango, faseActual: $entrega ? ($entrega['fase_id'] ?? '') : ($pre['fase_id'] ?? ''), campoFecha: 'fecha_limite', proyFijo: $entrega ? $entrega['proyecto_id'] : null}

        {if !$entrega}
        <label class="form-label mt-3">Planilla o archivos (opcional)</label>
        <input type="file" name="archivos[]" multiple class="form-input">
        <p class="form-hint mt-1">Sube un <strong>.csv</strong> y se crea un contenido por cada fila; o varias imágenes y se crea uno por imagen. El cliente y el proyecto son los que elegiste arriba: la planilla no los pide. <a href="{$admin_url('entregas/plantilla')}">Descargar plantilla</a></p>
        {/if}

        <p class="mt-4"><button type="submit" class="btn btn-primary">{if $entrega}Guardar{else}Crear{/if}</button></p>
    </form>
</div>

{if $entrega}
{var $st = $estados[$entrega['estado']] ?? ['—', 'muted']}
{var $tono = ['muted' => '', 'ok' => 'ok', 'warn' => 'warn', 'danger' => 'danger', 'info' => 'info'][$st[1]] ?? ''}
<div class="card mt-4">
    <div class="pa-row">
        <h2 class="pa-h2" style="margin:0">Estado</h2>
        <span class="pa-chip {$tono}">{$st[0]}</span>
        <span class="pa-muted">{$entrega['n_aprobados']} aprobados · {$entrega['n_cambios']} con cambios · {$entrega['n_pendientes']} por revisar</span>
    </div>
    {if $entrega['estado'] === 'respondida' || $entrega['estado'] === 'aprobada'}
        <p class="pa-muted mt-2">{$entrega['respondida_por']} envió su revisión {$fmt->rel($entrega['respondida_en'])}. {if $entrega['estado'] === 'respondida'}Abre cada contenido con cambios, responde y sube una versión nueva: la entrega se reabre sola.{/if}</p>
    {/if}
    <div class="pa-row mt-3">
        {if $entrega['estado'] === 'borrador'}
            <form method="post" action="{$admin_url('entregas/' . $entrega['id'] . '/publicar')}">
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <label class="pa-check" style="margin:0 .75rem 0 0"><input type="checkbox" name="avisar" value="1" checked> <span>Avisar al cliente por correo</span></label>
                <button type="submit" class="btn btn-primary" style="margin-top:.5rem">Publicar para el cliente</button>
            </form>
        {else}
            <form method="post" action="{$admin_url('entregas/' . $entrega['id'] . '/borrador')}" onsubmit="return confirm('El cliente dejará de ver esta entrega. ¿Continuar?');">
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <button type="submit" class="btn">Volver a borrador</button>
            </form>
        {/if}
        <form method="post" action="{$admin_url('entregas/' . $entrega['id'] . '/borrar')}" onsubmit="return confirm('¿Eliminar esta entrega con todos sus contenidos, archivos y comentarios?');">
            <input type="hidden" name="_csrf_token" value="{$csrf_token}">
            <button type="submit" class="btn btn-danger">Eliminar entrega</button>
        </form>
    </div>
</div>

<div class="card mt-4" id="contenidos">
    <div class="pa-row" style="justify-content:space-between">
        <h2 class="pa-h2" style="margin:0">Contenidos <span class="pa-chip">{count($contenidos)}</span></h2>
        {if $contenidos}<span class="pa-muted" style="font-size:.8rem">Suelta imágenes encima de una pieza para sumarle láminas.</span>{/if}
    </div>

    {if $contenidos}
    <ul class="pa-files pa-piezas mt-3">
        {foreach $contenidos as $c}
        {var $cs = $estadosContenido[$c['estado']] ?? ['—', 'muted']}
        {var $ct = ['muted' => '', 'ok' => 'ok', 'warn' => 'warn', 'danger' => 'danger', 'info' => 'info'][$cs[1]] ?? ''}
        {var $rc = $resumenReacc[$c['id']] ?? null}
        {var $fl = $faltas[$c['id']] ?? ['chips' => [], 'imagenes' => 0]}
        {var $mins = $miniaturas[$c['id']] ?? []}
        <li class="pa-file pa-pieza" id="pieza-{$c['id']}" data-pieza="{$c['id']}" data-pieza-titulo="{$c['titulo']}">
            <a href="{$admin_url('contenidos/' . $c['id'])}" class="pa-mini" aria-label="Abrir {$c['titulo']}">
                {if $mins}
                    {foreach $mins as $k => $aid}<img src="{$admin_url('archivos/' . $aid)}?t=1" alt="" loading="lazy" style="--k:{$k}">{/foreach}
                    {if $fl['imagenes'] > count($mins)}<span class="pa-mini-mas">+{$fl['imagenes'] - count($mins)}</span>{/if}
                {elseif isset($linkTapa[$c['id']])}
                    <img src="{$linkTapa[$c['id']]}" alt="" loading="lazy" referrerpolicy="no-referrer">
                {else}
                    <span class="pa-ico">{['post' => 'Post', 'reel' => 'Reel', 'story' => 'Story', 'grafica' => 'Gráfica', 'logo' => 'Logo', 'mockup' => 'Mockup', 'brandbook' => 'PDF', 'presentacion' => 'PDF', 'web' => 'Web'][$c['tipo']] ?? 'Archivo'}</span>
                {/if}
            </a>
            <div class="pa-meta">
                <a class="pa-name" href="{$admin_url('contenidos/' . $c['id'])}">{$c['titulo']}</a>
                <span class="pa-muted pa-pieza-meta">
                    <span>{$tipos[$c['tipo']][0] ?? $c['tipo']} · v{$c['version_actual']}{if $c['fecha_publicacion']} · publica {$fmt->fecha($c['fecha_publicacion'])}{/if}</span>
                    {foreach $fl['chips'] as $ch}<span class="pa-chip {$ch[1]}">{$ch[0]}</span>{/foreach}
                    <span class="pa-chip {$ct}" title="Lo que respondió el cliente">{$cs[0]}</span>
                    {if $rc && $rc['total'] > 0}{foreach $reacciones as $k => $r}{if $rc['conteo'][$k] > 0} {$r[0]}{$rc['conteo'][$k]}{/if}{/foreach}{/if}
                </span>
            </div>
            {if $c['version_id']}
            <form method="post" action="{$admin_url('contenidos/' . $c['id'] . '/archivos')}" enctype="multipart/form-data" class="pa-pieza-subir" data-pieza-form>
                <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                <input type="hidden" name="volver" value="{$admin_url('entregas/' . $entrega['id'])}">
                <label class="btn btn-sm" title="Sumar archivos a esta pieza">+ Archivos<input type="file" name="archivos[]" multiple accept="image/*,video/mp4,application/pdf" class="pa-oculto" data-pieza-input></label>
            </form>
            {/if}
            <form method="post" action="{$admin_url('contenidos/' . $c['id'] . '/mover')}"><input type="hidden" name="_csrf_token" value="{$csrf_token}"><input type="hidden" name="dir" value="arriba"><button type="submit" class="btn btn-sm" aria-label="Subir">↑</button></form>
            <form method="post" action="{$admin_url('contenidos/' . $c['id'] . '/mover')}"><input type="hidden" name="_csrf_token" value="{$csrf_token}"><input type="hidden" name="dir" value="abajo"><button type="submit" class="btn btn-sm" aria-label="Bajar">↓</button></form>
            <a href="{$admin_url('contenidos/' . $c['id'])}" class="btn btn-sm">Abrir</a>
        </li>
        {/foreach}
    </ul>
    {/if}

    {* ---- Una sola puerta para agregar ---- *}
    <form method="post" action="{$admin_url('entregas/' . $entrega['id'] . '/soltar')}" enctype="multipart/form-data" class="pa-soltar mt-3" id="soltar" data-soltar data-piezas="{json_encode($piezasJs)}" data-sin-tapa="{json_encode($sinTapa)}" data-tapa-url="{$admin_url('archivos/__ID__/tapa')}" data-link-url="{$admin_url('entregas/link')}" data-pdfjs="/plugins/portal/assets/pdf/pdf.min.js">
        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
        <div class="pa-dz" data-dz tabindex="-1">
            <span class="pa-dz-ico" aria-hidden="true">+</span>
            <strong>Agregar contenidos</strong>
            <span class="pa-muted">Arrastra aquí imágenes, videos, PDF, la grilla en Word o una planilla .csv. Antes de crear nada te mostramos qué va a pasar con cada archivo.</span>
            <div class="pa-row" style="justify-content:center">
                <label class="btn btn-primary">Elegir archivos<input type="file" name="archivos[]" multiple class="pa-oculto" data-dz-input accept="image/*,video/mp4,video/quicktime,application/pdf,.docx,.txt,.md,.csv,.zip,.pptx,.key,.ai,.psd,.svg"></label>
                <a href="#a-mano" class="btn" data-abrir="a-mano">Crear uno a mano</a>
                <a href="#grilla" class="btn" data-abrir="grilla">Pegar la grilla</a>
            </div>
            <span class="pa-muted" style="font-size:.75rem">Hasta 80 archivos, {$maxMb} MB cada uno. <a href="{$admin_url('entregas/plantilla')}">Plantilla .csv</a></span>
        </div>

        <div class="pa-revisar" data-revisar hidden>
            <div class="pa-row" style="justify-content:space-between">
                <h3 class="pa-h2" style="margin:0" data-revisar-titulo>Revisa antes de crear</h3>
                <button type="button" class="btn btn-sm" data-revisar-cancelar>Cancelar</button>
            </div>
            <p class="pa-muted" data-revisar-ayuda style="margin:.25rem 0 .75rem"></p>
            <div class="pa-map" data-revisar-lista></div>
            <div class="pa-grid-2 mt-3" data-revisar-extra hidden>
                <div><label class="form-label" for="s-carrusel">Título del carrusel nuevo</label><input id="s-carrusel" type="text" name="titulo_carrusel" class="form-input" maxlength="255" placeholder="Ej.: Post 11 · Antes y después"></div>
                <div><label class="form-label" for="s-cuenta">Cuenta (redes)</label><input id="s-cuenta" type="text" name="cuenta" class="form-input" maxlength="120" placeholder="@tumarca"></div>
            </div>
            <p class="mt-3"><button type="submit" class="btn btn-primary" data-revisar-ok>Agregar</button></p>
        </div>
    </form>
</div>

{* ---- Crear uno a mano: primero el tipo ---- *}
<details class="card mt-4 pa-plegable" id="a-mano">
    <summary class="pa-h2">Crear uno a mano</summary>
    <form method="post" action="{$admin_url('entregas/' . $entrega['id'] . '/contenidos')}" enctype="multipart/form-data" data-a-mano data-campos="{json_encode($tiposCampos)}">
        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
        <fieldset class="pa-tipos" style="border:0;padding:0;margin:0">
            <legend class="form-label">¿Qué vas a subir?</legend>
            {foreach $tipos as $k => $t}
                <label class="pa-tipo"><input type="radio" name="tipo" value="{$k}" {if $iterator->first}checked{/if}><b>{$t[0]}</b><span>{$t[2]}</span></label>
            {/foreach}
        </fieldset>

        <div class="pa-mano">
            <div>
                <div data-campo="archivos">
                    <label class="form-label mt-3" data-etq-archivos>Archivos</label>
                    <input type="file" name="archivos[]" multiple class="form-input" data-mano-archivos>
                    <div class="pa-mano-thumbs" data-mano-thumbs></div>
                    <p class="form-hint mt-1" data-hint-archivos>Hasta 10 archivos, {$maxMb} MB cada uno.</p>
                </div>
                <label class="form-label mt-3" for="m-titulo">Título</label>
                <input id="m-titulo" type="text" name="titulo" class="form-input" maxlength="255" placeholder="Ej.: Post 11 · Antes y después">
                <div data-campo="enlace"><label class="form-label mt-3" for="m-enlace" data-etq-enlace>Link</label><input id="m-enlace" type="url" name="enlace" class="form-input" maxlength="500" placeholder="https://…"></div>
                <div data-campo="copy"><label class="form-label mt-3" for="m-copy">Copy (con hashtags)</label><textarea id="m-copy" name="copy" class="form-input" rows="4" placeholder="El texto del post, con hashtags." data-mano-copy></textarea></div>
                <div class="pa-grid-2">
                    <div data-campo="cuenta"><label class="form-label mt-3" for="m-cuenta">Cuenta (redes)</label><input id="m-cuenta" type="text" name="cuenta" class="form-input" maxlength="120" placeholder="@tumarca" data-mano-cuenta></div>
                    <div data-campo="fecha"><label class="form-label mt-3" for="m-fecha">Se publica el</label><input id="m-fecha" type="date" name="fecha_publicacion" class="form-input"></div>
                </div>
                <details class="mt-3" data-mas>
                    <summary class="form-label" style="cursor:pointer" data-mas-txt>Más detalles: objetivo, láminas y notas</summary>
                    <div data-mas-campos></div>
                    {include '_brief.latte'}
                </details>
                <p class="mt-3"><button type="submit" class="btn btn-primary" data-mano-ok>Agregar</button></p>
            </div>
            <aside class="pa-vista" aria-label="Así lo verá el cliente" data-vista>
                <span class="pa-eyebrow">Así lo verá el cliente</span>
                <div class="pa-vista-media" data-vista-media><span>Sin archivos todavía</span></div>
                <p class="pa-muted pa-vista-pie" data-vista-pie></p>
                <div class="pa-tapa-ctrl" data-tapa-ctrl hidden>
                    <label class="form-label" for="m-tapa-cuadro">Tapa: elige el cuadro</label>
                    <input id="m-tapa-cuadro" type="range" min="0" max="1" step="0.1" value="1" disabled data-tapa-slider>
                    <label class="btn btn-sm" style="justify-self:start">Subir otra imagen como tapa<input type="file" accept="image/jpeg,image/png,image/webp" class="pa-oculto" data-tapa-propia></label>
                </div>
                <p class="pa-vista-copy" data-vista-copy></p>
            </aside>
        </div>
    </form>
</details>

{* ---- Grilla en Word o texto (también se puede soltar el .docx arriba) ---- *}
<details class="card mt-4 pa-plegable" id="grilla">
    <summary class="pa-h2">Leer una grilla (Word o texto)</summary>
    <p class="pa-muted">Sube la grilla en <strong>.docx</strong> o pega su texto. {if $iaActiva}La IA separa cada pieza en tipo, objetivo, láminas, copy y notas, sin reescribir el copy.{else}Se separa por etiquetas (POST 1, Tipo:, Objetivo:, Copy:, Lámina 2:…).{/if} Antes de crear nada ves una vista previa. Después suelta las imágenes arriba: van solas a su pieza si el nombre trae el número (<code>3.jpg</code>, <code>3-2.jpg</code>).</p>
    <form method="post" action="{$admin_url('entregas/' . $entrega['id'] . '/grilla')}" enctype="multipart/form-data" data-grilla-form>
        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
        <label class="form-label mt-3" for="g-arch">Archivo .docx</label>
        <input id="g-arch" type="file" name="grilla" accept=".docx,.txt,.md" class="form-input" data-grilla-input>
        <label class="form-label mt-3" for="g-texto">…o pega el texto</label>
        <textarea id="g-texto" name="texto" class="form-input" rows="4" placeholder="POST 1&#10;Tipo: Carrusel (7 láminas)&#10;Objetivo: …&#10;Copy: …"></textarea>
        <label class="form-label mt-3" for="g-cuenta">Cuenta (redes)</label>
        <input id="g-cuenta" type="text" name="cuenta" class="form-input" maxlength="120" placeholder="@tumarca">
        {if $iaActiva}<label class="pa-check"><input type="checkbox" name="modo" value="simple"> <span>Leer sin IA (sólo por etiquetas, al instante)</span></label>{/if}
        <p class="mt-3"><button type="submit" class="btn btn-primary">Leer la grilla</button></p>
    </form>
</details>

{include '_tapas.js.latte'}
{include '_subida.js.latte'}

{/if}
{/block}
