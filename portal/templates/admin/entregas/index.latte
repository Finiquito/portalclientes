{layout $plugin_ui_layout}

{block page_title}Contenidos{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/portal-admin.css?v=5">

<div class="page-header">
    <h1>Entregas de contenido</h1>
    <a href="{$admin_url('entregas/nuevo')}{if $filtros->get('proyecto')}?proyecto_id={$filtros->get('proyecto')}{/if}" class="btn btn-primary">Nueva entrega</a>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

<div class="pa-filtros">
    <div class="pa-pills" role="navigation" aria-label="Estado">
        {foreach $grupos as $g => $txt}
            <a href="{$filtros->url(['estado' => $g])}" class="pa-pill" {if $filtros->es('estado', $g)}aria-current="true"{/if}>{$txt} <span class="pa-n">{$conteos[$g]}</span></a>
        {/foreach}
    </div>
    <form method="get" action="{$filtros->url(['proyecto' => ''])}" class="pa-selects" data-auto>
        <input type="hidden" name="estado" value="{$filtros->get('estado')}">
        <label for="f-proy">Proyecto</label>
        <select id="f-proy" name="proyecto" class="form-input" style="width:auto">
            <option value="">Todos los proyectos</option>
            {foreach $proyectosF as $p}
                <option value="{$p['id']}" {if $filtros->es('proyecto', $p['id'])}selected{/if}>{$p['cliente_nombre']} · {$p['nombre']}</option>
            {/foreach}
        </select>
        <noscript><button type="submit" class="btn btn-sm">Filtrar</button></noscript>
        {if $filtros->get('proyecto')}<a href="{$filtros->url(['proyecto' => ''])}" class="pa-muted">Quitar filtro</a>{/if}
    </form>
</div>

{if empty($entregas)}
    <div class="card">
        <p class="pa-muted" style="margin:0">{if $conteos['todas'] === 0}Todavía no hay entregas. Una entrega es el paquete que el cliente revisa de una sola vez: una grilla de redes, una identidad de marca, un sitio…{else}No hay entregas con estos filtros.{/if}</p>
    </div>
{else}
<div class="card" style="overflow-x:auto">
    <table class="table">
        <thead><tr><th>Entrega</th><th>Proyecto</th><th>Estado</th><th>Revisión</th><th>Límite</th><th></th></tr></thead>
        <tbody>
        {foreach $entregas as $e}
            {var $st = $estados[$e['estado']] ?? ['—', 'muted']}
            {var $tono = ['muted' => '', 'ok' => 'ok', 'warn' => 'warn', 'danger' => 'danger', 'info' => 'info'][$st[1]] ?? ''}
            <tr {if $e['estado'] === 'respondida'}class="pa-new"{/if}>
                <td><a href="{$admin_url('entregas/' . $e['id'])}">{$e['titulo']}</a><div class="pa-muted">{$e['n_total']} contenido(s)</div></td>
                <td>
                    <span class="pa-proy"><span class="pa-dot" style="background: {($colorProy[$e['proyecto_id']] ?? '#94a3b8')|noescape}" aria-hidden="true"></span>{$e['proyecto_nombre']}</span>
                    <div class="pa-muted">{$e['cliente_nombre']}</div>
                </td>
                <td><span class="pa-chip {$tono}">{$st[0]}</span></td>
                <td class="pa-muted">{$e['n_aprobados']} aprobados · {$e['n_cambios']} con cambios · {$e['n_pendientes']} por revisar</td>
                <td>{$fmt->fecha($e['fecha_limite'])}</td>
                <td><button type="submit" form="borrar-{$e['id']}" class="btn btn-sm btn-danger">Eliminar</button></td>
            </tr>
        {/foreach}
        </tbody>
    </table>
</div>
{foreach $entregas as $e}
    <form method="post" action="{$admin_url('entregas/' . $e['id'] . '/borrar')}" id="borrar-{$e['id']}" onsubmit="return confirm('¿Eliminar esta entrega con todos sus contenidos, archivos y comentarios?');" hidden>
        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
    </form>
{/foreach}
{/if}

{include '../_filtros.js.latte'}
{/block}
