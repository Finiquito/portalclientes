{layout $plugin_ui_layout}

{block page_title}Contenidos{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/portal-admin.css">

<div class="page-header">
    <h1>Entregas de contenido</h1>
    <a href="{$admin_url('entregas/nuevo')}" class="btn btn-primary">Nueva entrega</a>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

{if empty($entregas)}
    <div class="card">
        <p class="pa-muted">Todavía no hay entregas. Una entrega es el paquete que el cliente revisa de una sola vez: una grilla de redes, una identidad de marca, un sitio…</p>
    </div>
{else}
<div class="card" style="overflow-x:auto">
    <table class="table">
        <thead><tr><th>Entrega</th><th>Cliente / proyecto</th><th>Estado</th><th>Revisión</th><th>Límite</th><th></th></tr></thead>
        <tbody>
        {foreach $entregas as $e}
            {var $st = $estados[$e['estado']] ?? ['—', 'muted']}
            {var $tono = ['muted' => '', 'ok' => 'ok', 'warn' => 'warn', 'danger' => 'danger', 'info' => 'info'][$st[1]] ?? ''}
            <tr {if $e['estado'] === 'respondida'}class="pa-new"{/if}>
                <td><a href="{$admin_url('entregas/' . $e['id'])}">{$e['titulo']}</a><div class="pa-muted">{$e['n_total']} contenido(s)</div></td>
                <td>{$e['cliente_nombre']}<div class="pa-muted">{$e['proyecto_nombre']}</div></td>
                <td><span class="pa-chip {$tono}">{$st[0]}</span></td>
                <td class="pa-muted">{$e['n_aprobados']} aprobados · {$e['n_cambios']} con cambios · {$e['n_pendientes']} por revisar</td>
                <td>{$fmt->fecha($e['fecha_limite'])}</td>
                <td>
                    <form method="post" action="{$admin_url('entregas/' . $e['id'] . '/borrar')}" onsubmit="return confirm('¿Eliminar esta entrega con todos sus contenidos, archivos y comentarios?');">
                        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        {/foreach}
        </tbody>
    </table>
</div>
{/if}
{/block}
