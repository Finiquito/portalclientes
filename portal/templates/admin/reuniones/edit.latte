{layout $plugin_ui_layout}

{block page_title}{$reunion['titulo']}{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/portal-admin.css?v=17">
{* Fechas en la hora de la agencia; debajo se muestra la del cliente *}
{var $fecha10 = substr((string) $reunion['fecha'], 0, 10)}
{var $hora = strlen((string) $reunion['fecha']) > 10 ? substr((string) $reunion['fecha'], 11, 5) : ''}
{var $pf10 = substr((string) $reunion['prox_fecha'], 0, 10)}
{var $ph = strlen((string) $reunion['prox_fecha']) > 10 ? substr((string) $reunion['prox_fecha'], 11, 5) : ''}

<div class="page-header">
    <h1>{$reunion['titulo']}</h1>
    <a href="{$admin_url('reuniones')}" class="btn">Volver</a>
</div>
<p class="pa-muted" style="margin:-.5rem 0 1rem">{$reunion['cliente_nombre']} · {$reunion['proyecto_nombre']}</p>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

<form method="post" action="{$admin_url('reuniones/' . $reunion['id'])}" class="pa-stack">
    <input type="hidden" name="_csrf_token" value="{$csrf_token}">
    {* Botón por defecto (Enter en un campo): guarda, nunca dispara la IA. *}
    <button type="submit" name="accion" value="guardar" class="pa-hidden-submit" tabindex="-1" aria-hidden="true">Guardar</button>

    {* 1. Datos y Meet *}
    <div class="card">
        <h2 class="pa-h2">1 · Datos de la reunión</h2>
        <label class="form-label">Proyecto</label>
        <select name="proyecto_id" class="form-input" required data-proyecto-zona>
            {foreach $proyectos as $p}
                 <option value="{$p['id']}" data-cliente="{$p['cliente_id']}" data-zona="{\TypeDock\Plugin\Portal\HorarioHabil::zonaDe((string) ($p['cliente_pais'] ?? ''))}" data-pais="{\TypeDock\Plugin\Portal\HorarioHabil::nombreDe((string) ($p['cliente_pais'] ?? ''))} {\TypeDock\Plugin\Portal\Fmt::bandera(\TypeDock\Plugin\Portal\HorarioHabil::paisValido((string) ($p['cliente_pais'] ?? '')))}" {if $reunion['proyecto_id'] === $p['id']}selected{/if}>{$p['cliente_nombre']} · {$p['nombre']}</option>
            {/foreach}
        </select>
        <label class="form-label mt-3">Título</label>
        <input type="text" name="titulo" class="form-input" value="{$reunion['titulo']}" required maxlength="255">
        <div class="pa-inline mt-3">
            <div><label class="form-label">Fecha</label><input type="date" name="fecha_d" class="form-input" value="{$fecha10}"></div>
            <div><label class="form-label">Hora ({$nombreAgencia} {\TypeDock\Plugin\Portal\Fmt::bandera($paisAgencia)})</label><input type="time" name="fecha_t" class="form-input" value="{$hora}"></div>
            <div><label class="form-label">Duración (min)</label><input type="number" name="duracion_min" class="form-input" value="{$reunion['duracion_min']}" min="5" max="600" style="max-width:7rem"></div>
        </div>
        <p class="form-hint mt-1" data-equiv="fecha" data-zona-agencia="{$zonaAgencia}" data-nombre-agencia="{$nombreAgencia}"></p>
        <label class="form-label mt-3">Link de Google Meet</label>
        <input type="url" name="enlace_meet" class="form-input" value="{$reunion['enlace_meet']}" maxlength="500" placeholder="https://meet.google.com/…">
        <p class="form-hint mt-1">
            <a href="https://meet.google.com/new" target="_blank" rel="noopener noreferrer">Crear una reunión de Meet</a>
            {if $gcal} · <a href="{$gcal}" target="_blank" rel="noopener noreferrer">Crear evento en Google Calendar</a> (rellenado; ahí puedes añadir Meet e invitar al cliente){/if}
        </p>
        <label class="form-label mt-3">Grabación (opcional)</label>
        <input type="url" name="enlace_grabacion" class="form-input" value="{$reunion['enlace_grabacion']}" maxlength="500" placeholder="https://drive.google.com/…">
        {include '../_fase_campo.latte', fasesRango: $fasesRango, faseActual: $reunion['fase_id'] ?? '', campoFecha: 'fecha_d', proyFijo: null, esHito: (bool) ($reunion['es_hito'] ?? 0)}
        <p class="form-hint mt-3">Qué ve el cliente de esta reunión se decide al final, en «Qué ve el cliente».</p>

        {include '_convocados.latte', nueva: false}
    </div>

    {* 2. Transcripción *}
    <div class="card">
        <h2 class="pa-h2">2 · Transcripción o notas <span class="pa-lock">🔒 sólo el equipo la ve</span></h2>
        <textarea name="transcripcion" class="form-input" rows="8" placeholder="Pega aquí la transcripción de la reunión (Meet, Gemini, Fireflies, Otter…) o tus notas.">{$reunion['transcripcion']}</textarea>
        {if $iaActiva}
            <div class="pa-ia mt-3">
                <div class="pa-ia-fila">
                    <div class="pa-ia-txt">
                        <strong>✨ Analizar con IA</strong>
                        <p>Propone resumen, acuerdos, tareas y próxima reunión a partir de la transcripción. Es sólo una propuesta: la revisas abajo y decides qué se crea y qué ve el cliente.</p>
                    </div>
                    <button type="submit" name="accion" value="analizar" class="btn btn-primary"
                            onclick="return !document.querySelector('[name=resumen]').value.trim() || confirm('Esto reemplaza el resumen, los acuerdos, el análisis y las tareas propuestas que aún no hayas creado. ¿Continuar?');">Analizar con IA</button>
                </div>
                <p class="pa-ia-meta">
                    <span>⏱ Tarda entre 10 y 60 segundos</span>
                    <span>El texto se envía al proveedor de IA elegido en Ajustes</span>
                    {if $reunion['ia_generado_en']}<span>Última propuesta: {$fmt->rel($reunion['ia_generado_en'])} · {$reunion['ia_modelo']}</span>{/if}
                </p>
            </div>
        {else}
            <p class="form-hint mt-2">La IA es opcional y hoy no está conectada. Puedes escribir el resumen y las tareas a mano, o activarla con una clave en <a href="{$admin_url('ajustes')}">Ajustes</a>.</p>
        {/if}
    </div>

    {* 3. Resumen *}
    <div class="card">
        <h2 class="pa-h2">3 · Resumen para el cliente</h2>
        <label class="form-label">Resumen</label>
        <textarea name="resumen" class="form-input" rows="6" placeholder="Qué se conversó y qué se decidió.">{$reunion['resumen']}</textarea>
        <label class="form-label mt-3">Acuerdos <span class="pa-muted">(uno por línea)</span></label>
        <textarea name="acuerdos" class="form-input" rows="4">{$reunion['acuerdos']}</textarea>
        <label class="form-label mt-3">Análisis interno <span class="pa-lock">🔒 el cliente nunca lo ve</span></label>
        <textarea name="analisis" class="form-input" rows="4" placeholder="Riesgos, dudas del cliente, temas pendientes…">{$reunion['analisis']}</textarea>
    </div>

    {* 4. Tareas: las creadas siguen editables; en las sugeridas se elige Crear o Descartar (sin elegir = pendiente). *}
    {var $creadas = $tareasReunion['creadas']}
    {var $sugeridas = $tareasReunion['sugeridas']}
    {var $todasIa = $sugeridas !== [] && count(array_filter($sugeridas, fn($q) => $q['origen'] === 'ia')) === count($sugeridas)}
    <div class="card" data-tareas-reunion>
        <h2 class="pa-h2">4 · Tareas de la reunión</h2>
        <p class="pa-t-bajada">Las creadas ya existen y puedes seguir ajustándolas aquí. En las sugeridas, elige <b>Crear</b> o <b>Descartar</b>; las que dejes sin elegir quedan pendientes para decidir otro día.</p>

        {define tarjeta, $q, $n, $creada}
            {var $cli = $q['asignado'] === 'cliente'}
            {var $ve = $cli || (int) $q['visible_cliente'] === 1}
            <article class="pa-t{if $creada} es-creada{/if}" data-tarea="{$creada ? 'creada' : 'sugerida'}" data-id="{$q['id']}">
                <div class="pa-t-cuerpo">
                    <textarea name="{$n}[titulo]" class="pa-t-titulo" rows="1" maxlength="255" aria-label="Título de la tarea">{$q['titulo']}</textarea>
                    <textarea name="{$n}[descripcion]" class="pa-t-detalle" rows="1" maxlength="4000" placeholder="Detalle (opcional)" aria-label="Detalle de la tarea">{$q['descripcion']}</textarea>
                </div>
                <div class="pa-t-lado">
                    {if $creada}
                        <span class="pa-t-estado">✓ Creada{if $q['tarea_id']} · <a href="{$admin_url('tareas/' . $q['tarea_id'])}">ver tarea</a>{/if}</span>
                    {else}
                        <div class="pa-t-dec" role="group" aria-label="Decidir esta sugerencia">
                            <label class="pa-acc crear"><input type="radio" name="decision[{$q['id']}]" value="crear"> ✓ Crear</label>
                            <label class="pa-acc descartar"><input type="radio" name="decision[{$q['id']}]" value="descartar"> ✕ Descartar</label>
                        </div>
                    {/if}
                </div>
                <div class="pa-t-meta">
                    <span class="pa-t-campo">Responsable
                        <span class="pa-seg">
                            <label><input type="radio" name="{$n}[asignado]" value="equipo" {if !$cli}checked{/if}><span>Equipo</span></label>
                            <label><input type="radio" name="{$n}[asignado]" value="cliente" {if $cli}checked{/if}><span>Cliente</span></label>
                        </span>
                    </span>
                    <label class="pa-t-campo">Vence <input type="date" name="{$n}[fecha_vencimiento]" class="form-input pa-t-fecha" value="{$q['fecha_vencimiento']}"></label>
                    <label class="pa-t-campo pa-t-ve">
                        <input type="checkbox" role="switch" class="pa-sw" name="{$n}[visible_cliente]" value="1" {if $ve}checked{/if} {if $cli}disabled{/if} data-ve>
                        <span data-ve-txt>{if $cli}Lo ve el cliente <small>· siempre, le toca a él</small>{elseif $ve}Lo ve el cliente{else}Solo el equipo{/if}</span>
                    </label>
                    <span class="pa-t-cambio" hidden>● Cambio sin guardar</span>
                    {if !$creada}
                        {if $q['origen'] === 'ia'}<span class="pa-chip brand pa-t-ia">✨ Sugerida por IA</span>{else}<span class="pa-chip gris pa-t-ia">Agregada a mano</span>{/if}
                    {/if}
                </div>
            </article>
        {/define}

        {if $creadas !== []}
            <h3 class="pa-t-grupo">Creadas <span>· {count($creadas)}</span></h3>
            <div class="pa-t-lista">
                {foreach $creadas as $q}
                    {if $q['editable']}
                        {include tarjeta, q: $q, n: 'creada[' . $q['id'] . ']', creada: true}
                    {else}
                        <article class="pa-t es-creada es-borrada"><div class="pa-t-cuerpo"><span class="pa-t-titulo-fijo">{$q['titulo']}</span></div><div class="pa-t-lado"><span class="pa-chip gris">La tarea se borró</span></div></article>
                    {/if}
                {/foreach}
            </div>
        {/if}

        <h3 class="pa-t-grupo">{$todasIa ? 'Sugeridas por la IA' : 'Por decidir'} <span>· {count($sugeridas)}</span></h3>
        <div class="pa-t-lista">
            {foreach $sugeridas as $q}
                {include tarjeta, q: $q, n: 'prop[' . $q['id'] . ']', creada: false}
            {else}
                <p class="pa-muted">No quedan sugerencias por decidir.</p>
            {/foreach}
        </div>

        <div class="pa-t pa-t-nueva" data-tarea="nueva">
            <div class="pa-t-cuerpo">
                <input type="text" name="nueva[titulo]" class="pa-t-titulo" placeholder="＋ Agregar una tarea a mano…" maxlength="255" aria-label="Agregar una tarea a mano" data-nueva>
            </div>
            <div class="pa-t-lado"><span class="pa-muted">Se crea al guardar</span></div>
            <div class="pa-t-meta">
                <span class="pa-t-campo">Responsable
                    <span class="pa-seg">
                        <label><input type="radio" name="nueva[asignado]" value="equipo" checked><span>Equipo</span></label>
                        <label><input type="radio" name="nueva[asignado]" value="cliente"><span>Cliente</span></label>
                    </span>
                </span>
                <label class="pa-t-campo">Vence <input type="date" name="nueva[fecha_vencimiento]" class="form-input pa-t-fecha"></label>
                <label class="pa-t-campo pa-t-ve">
                    <input type="checkbox" role="switch" class="pa-sw" name="nueva[visible_cliente]" value="1" data-ve>
                    <span data-ve-txt>Solo el equipo</span>
                </label>
            </div>
        </div>
    </div>

    {* 5. Próxima reunión *}
    <div class="card">
        <h2 class="pa-h2">5 · Próxima reunión</h2>
        {if $proxima}
            <p>Ya agendada: <a href="{$admin_url('reuniones/' . $proxima['id'])}">{$proxima['titulo']}</a> · {$fmt->fechaLarga($proxima['fecha'])} {$fmt->hora($proxima['fecha'])}</p>
            <input type="hidden" name="prox_fecha_d" value="{$pf10}"><input type="hidden" name="prox_fecha_t" value="{$ph}"><input type="hidden" name="prox_titulo" value="{$reunion['prox_titulo']}">
        {else}
            <div class="pa-inline">
                <div><label class="form-label">Fecha</label><input type="date" name="prox_fecha_d" class="form-input" value="{$pf10}"></div>
                <div><label class="form-label">Hora ({$nombreAgencia} {\TypeDock\Plugin\Portal\Fmt::bandera($paisAgencia)})</label><input type="time" name="prox_fecha_t" class="form-input" value="{$ph}"></div>
                <div style="flex:1;min-width:14rem"><label class="form-label">Tema</label><input type="text" name="prox_titulo" class="form-input" value="{$reunion['prox_titulo']}" maxlength="255"></div>
            </div>
            <p class="form-hint mt-1" data-equiv="prox_fecha" data-zona-agencia="{$zonaAgencia}" data-nombre-agencia="{$nombreAgencia}"></p>
            <label class="pa-check"><input type="checkbox" name="agendar_prox" value="1" data-agendar> Agendarla al guardar como reunión de este proyecto, con los mismos convocados (después le pones el link de Meet)</label>
        {/if}
    </div>

    {* Qué ve el cliente: todo lo que se publica, en un solo lugar, y un único Guardar. *}
    <div class="card pa-ve" data-publica>
        <h2 class="pa-h2">Qué ve el cliente</h2>
        <p class="pa-t-bajada">Todo lo que se publica de esta reunión, en un solo lugar. Puedes cambiarlo cuando quieras y volver a guardar.</p>
        <div class="pa-ve-filas">
            <label class="pa-ve-fila">
                <span class="pa-ve-txt"><b>La reunión</b><span>Aparece en su lista de «Reuniones».</span></span>
                <input type="checkbox" role="switch" class="pa-sw" name="publicada" value="1" {if $reunion['publicada']}checked{/if} data-pub="reunion">
            </label>
            <label class="pa-ve-fila">
                <span class="pa-ve-txt"><b>Resumen y acuerdos</b><span data-pub-nota="resumen">Lo escrito en la sección 3, con la grabación si la hay.</span></span>
                <input type="checkbox" role="switch" class="pa-sw" name="resumen_publicado" value="1" {if $reunion['resumen_publicado']}checked{/if} data-pub="resumen">
            </label>
            <div class="pa-ve-fila">
                <span class="pa-ve-txt"><b>Tareas visibles <span class="pa-ve-cuenta" data-n-visibles></span></b><span>Se decide en cada tarea con «Lo ve el cliente». Las ve en su sección «Tareas».</span></span>
            </div>
            <label class="pa-ve-fila">
                {if $proxima}
                    <span class="pa-ve-txt"><b>Próxima reunión</b><span>{$proxima['titulo']} · {$fmt->fechaLarga($proxima['fecha'])} {$fmt->hora($proxima['fecha'])}</span></span>
                    <input type="hidden" name="prox_form" value="1">
                    <input type="checkbox" role="switch" class="pa-sw" name="prox_publicar" value="1" {if $proxima['publicada']}checked{/if} data-pub="prox">
                {else}
                    <span class="pa-ve-txt"><b>Próxima reunión</b><span data-pub-nota="prox">Se puede mostrar si la agendas al guardar (sección 5).</span></span>
                    <input type="checkbox" role="switch" class="pa-sw" name="prox_publicar" value="1" data-pub="prox" data-pub-pendiente>
                {/if}
            </label>
            <label class="pa-ve-fila">
                <span class="pa-ve-txt"><b>Avisarle por correo</b><span>Un solo correo con lo nuevo que pueda ver.</span></span>
                <input type="checkbox" role="switch" class="pa-sw" name="avisar" value="1" data-pub="correo">
            </label>
        </div>
        <div class="pa-ve-resumen" data-al-guardar aria-live="polite"></div>
        <div class="pa-ve-pie">
            <button type="submit" name="accion" value="guardar" class="btn btn-primary">Guardar</button>
            <p class="pa-muted">Guarda todo: los textos, los cambios en las tareas creadas, las que marcaste para crear y lo que ve el cliente.</p>
        </div>
    </div>
</form>

<script>
window.PA_I18N = Object.assign(window.PA_I18N || {}, {
  "Lo ve el cliente": {t('Lo ve el cliente')},
  "· siempre, le toca a él": {t('· siempre, le toca a él')},
  "Solo el equipo": {t('Solo el equipo')},
  "Se puede mostrar si la agendas al guardar (sección 5).": {t('Se puede mostrar si la agendas al guardar (sección 5).')},
  "Se agenda al guardar; elige si la ve.": {t('Se agenda al guardar; elige si la ve.')},
  "Lo escrito en la sección 3, con la grabación si la hay.": {t('Lo escrito en la sección 3, con la grabación si la hay.')},
  "Necesita que la reunión esté visible.": {t('Necesita que la reunión esté visible.')},
  "Se crea 1 tarea.": {t('Se crea 1 tarea.')},
  "Se crean %d tareas.": {t('Se crean %d tareas.')},
  "Se actualiza 1 tarea creada.": {t('Se actualiza 1 tarea creada.')},
  "Se actualizan %d tareas creadas.": {t('Se actualizan %d tareas creadas.')},
  "Se descarta 1 sugerencia.": {t('Se descarta 1 sugerencia.')},
  "Se descartan %d sugerencias.": {t('Se descartan %d sugerencias.')},
  "1 sugerencia queda pendiente para otro día.": {t('1 sugerencia queda pendiente para otro día.')},
  "%d sugerencias quedan pendientes para otro día.": {t('%d sugerencias quedan pendientes para otro día.')},
  "Se agenda la próxima reunión.": {t('Se agenda la próxima reunión.')},
  "la reunión": {t('la reunión')},
  "el resumen y los acuerdos": {t('el resumen y los acuerdos')},
  "1 tarea": {t('1 tarea')},
  "%d tareas": {t('%d tareas')},
  "la próxima reunión": {t('la próxima reunión')},
  "El cliente verá ": {t('El cliente verá ')},
  "y": {t('y')},
  "El cliente no verá nada de esta reunión.": {t('El cliente no verá nada de esta reunión.')},
  "Le llega un correo con lo nuevo que pueda ver.": {t('Le llega un correo con lo nuevo que pueda ver.')},
  "No se le envía correo.": {t('No se le envía correo.')},
  "Al guardar": {t('Al guardar')}
});
window.__t = window.__t || function (s) { var d = window.PA_I18N || {}; return d[s] !== undefined ? d[s] : s; };
</script>
<script n:syntax="off">
    /* Tareas de la reunión y «Qué ve el cliente»: Crear/Descartar se desmarcan con otro clic,
       «Lo ve el cliente» queda fijo si la tarea es del cliente, aviso de cambios sin guardar
       en las creadas y la lista «Al guardar» con lo que va a pasar. */
    (function () {
        var form = document.querySelector('form.pa-stack'), caja = document.querySelector('[data-al-guardar]');
        if (!form || !caja) return;
        var tarjetas = Array.prototype.slice.call(form.querySelectorAll('[data-tarea]'));
        function foto(t) {
            return Array.prototype.map.call(t.querySelectorAll('input:not([name^="decision"]), textarea'), function (i) {
                return i.type === 'radio' || i.type === 'checkbox' ? (i.checked ? 1 : 0) : i.value;
            }).join('|');
        }
        tarjetas.forEach(function (t) { t.dataset.orig = foto(t); });
        var previo = {};
        form.querySelectorAll('input[name^="decision"]').forEach(function (r) { if (r.checked) previo[r.name] = r.value; });
        form.addEventListener('click', function (e) {
            var r = e.target.closest('input[type=radio][name^="decision"]');
            if (!r) return;
            if (previo[r.name] === r.value) { r.checked = false; previo[r.name] = ''; } else { previo[r.name] = r.value; }
            pintar();
        });
        function ve(t) {
            var cli = t.querySelector('input[name$="[asignado]"][value=cliente]'), sw = t.querySelector('[data-ve]');
            return (cli && cli.checked) || (sw && sw.checked);
        }
        function plural(n, uno, varios) { return n + ' ' + (n === 1 ? uno : varios); }
        function pintar() {
            var crear = 0, cambios = 0, desc = 0, pend = 0, vis = 0;
            tarjetas.forEach(function (t) {
                var tipo = t.dataset.tarea, cli = t.querySelector('input[name$="[asignado]"][value=cliente]'), sw = t.querySelector('[data-ve]'), txt = t.querySelector('[data-ve-txt]');
                if (sw && cli) {
                    if (cli.checked) { if (!sw.disabled) { sw.dataset.antes = sw.checked ? '1' : ''; } sw.checked = true; sw.disabled = true; }
                    else if (sw.disabled) { sw.disabled = false; sw.checked = sw.dataset.antes === '1'; }
                    txt.innerHTML = cli.checked ? __t('Lo ve el cliente') + ' <small>' + __t('· siempre, le toca a él') + '</small>' : (sw.checked ? __t('Lo ve el cliente') : __t('Solo el equipo'));
                }
                var d = t.querySelector('input[name^="decision"]:checked');
                t.dataset.d = d ? d.value : '';
                if (tipo === 'creada') {
                    var cambio = foto(t) !== t.dataset.orig;
                    t.querySelector('.pa-t-cambio').hidden = !cambio;
                    t.classList.toggle('con-cambio', cambio);
                    if (cambio) cambios++;
                    if (ve(t)) vis++;
                } else if (tipo === 'nueva') {
                    if (t.querySelector('[data-nueva]').value.trim() !== '') { crear++; if (ve(t)) vis++; }
                } else if (d && d.value === 'crear') { crear++; if (ve(t)) vis++; }
                else if (d) { desc++; } else { pend++; }
            });
            var pub = function (k) { var i = form.querySelector('[data-pub="' + k + '"]'); return i && i.checked && !i.disabled; };
            var agendar = form.querySelector('[data-agendar]'), proxSw = form.querySelector('[data-pub-pendiente]');
            if (proxSw) {
                proxSw.disabled = !(agendar && agendar.checked);
                form.querySelector('[data-pub-nota="prox"]').textContent = proxSw.disabled ? __t('Se puede mostrar si la agendas al guardar (sección 5).') : __t('Se agenda al guardar; elige si la ve.');
            }
            var reunion = pub('reunion');
            form.querySelector('[data-pub-nota="resumen"]').textContent = reunion ? __t('Lo escrito en la sección 3, con la grabación si la hay.') : __t('Necesita que la reunión esté visible.');
            form.querySelector('[data-n-visibles]').textContent = '· ' + vis;
            var li = [];
            if (crear) li.push(crear === 1 ? __t('Se crea 1 tarea.') : __t('Se crean %d tareas.').replace('%d', crear));
            if (cambios) li.push(cambios === 1 ? __t('Se actualiza 1 tarea creada.') : __t('Se actualizan %d tareas creadas.').replace('%d', cambios));
            if (desc) li.push(desc === 1 ? __t('Se descarta 1 sugerencia.') : __t('Se descartan %d sugerencias.').replace('%d', desc));
            if (pend) li.push(pend === 1 ? __t('1 sugerencia queda pendiente para otro día.') : __t('%d sugerencias quedan pendientes para otro día.').replace('%d', pend));
            if (agendar && agendar.checked) li.push(__t('Se agenda la próxima reunión.'));
            var veCli = [];
            if (reunion) veCli.push(__t('la reunión'));
            if (reunion && pub('resumen')) veCli.push(__t('el resumen y los acuerdos'));
            if (vis) veCli.push(vis === 1 ? __t('1 tarea') : __t('%d tareas').replace('%d', vis));
            if (pub('prox')) veCli.push(__t('la próxima reunión'));
            li.push(veCli.length ? __t('El cliente verá ') + veCli.join(', ').replace(/, ([^,]*)$/, ' '+__t('y')+' $1') + '.' : __t('El cliente no verá nada de esta reunión.'));
            li.push(pub('correo') ? __t('Le llega un correo con lo nuevo que pueda ver.') : __t('No se le envía correo.'));
            caja.innerHTML = '<b>' + __t('Al guardar') + '</b><ul><li>' + li.join('</li><li>') + '</li></ul>';
        }
        form.addEventListener('input', pintar);
        form.addEventListener('change', pintar);
        /* El detalle crece con el texto */
        form.querySelectorAll('.pa-t-detalle, textarea.pa-t-titulo').forEach(function (a) {
            var titulo = a.classList.contains('pa-t-titulo');
            var ajustar = function () {
                if (titulo && /\n/.test(a.value)) a.value = a.value.replace(/\s*\n\s*/g, ' ');   /* el título va en una línea */
                a.style.height = 'auto'; a.style.height = a.scrollHeight + 'px';
            };
            if (titulo) a.addEventListener('keydown', function (e) { if (e.key === 'Enter') e.preventDefault(); });
            a.addEventListener('input', ajustar); ajustar();
            window.addEventListener('resize', ajustar);
        });
        pintar();
    })();
</script>

{if $iaActiva}
<div id="pa-ia-espera" hidden role="status" aria-live="polite">
    <div class="pa-ia-caja">
        <div class="pa-ia-spin" aria-hidden="true"></div>
        <p class="pa-ia-titulo">La IA está trabajando…</p>
        <p class="pa-ia-paso" id="pa-ia-paso">Leyendo la transcripción</p>
        <div class="pa-ia-barra" aria-hidden="true"><span></span></div>
        <p class="pa-ia-nota"><span id="pa-ia-seg">0</span> s · No cierres ni recargues esta página; al terminar te lleva de vuelta con la propuesta lista para revisar.</p>
    </div>
</div>
<style n:syntax="off">
    #pa-ia-espera { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; background: rgba(15, 23, 42, .55); backdrop-filter: blur(2px); padding: 1rem; }
    #pa-ia-espera[hidden] { display: none; }
    .pa-ia-caja { background: #fff; color: #0f172a; color-scheme: light; border-radius: 1rem; padding: 1.75rem 2rem; max-width: 26rem; width: 100%; text-align: center; box-shadow: 0 20px 50px rgba(0, 0, 0, .3); }
    .pa-ia-spin { width: 2.6rem; height: 2.6rem; margin: 0 auto 1rem; border: 4px solid #e2e8f0; border-top-color: #6366f1; border-radius: 50%; animation: pa-ia-gira 0.9s linear infinite; }
    .pa-ia-titulo { font-weight: 800; font-size: 1.1rem; margin: 0 0 .25rem; }
    .pa-ia-paso { margin: 0 0 1rem; color: #475569; min-height: 1.4em; }
    .pa-ia-barra { height: .4rem; background: #e2e8f0; border-radius: 99px; overflow: hidden; }
    .pa-ia-barra span { display: block; height: 100%; width: 35%; background: #6366f1; border-radius: 99px; animation: pa-ia-barra 1.4s ease-in-out infinite; }
    .pa-ia-nota { margin: .9rem 0 0; font-size: .8rem; color: #64748b; }
    @keyframes pa-ia-gira { to { transform: rotate(360deg); } }
    @keyframes pa-ia-barra { 0% { margin-left: -35%; } 100% { margin-left: 100%; } }
    @media (prefers-reduced-motion: reduce) { .pa-ia-spin, .pa-ia-barra span { animation-duration: 3s; } }
</style>
<script>
window.PA_I18N = Object.assign(window.PA_I18N || {}, {
  "Leyendo la transcripción": {t('Leyendo la transcripción')},
  "Identificando acuerdos y decisiones": {t('Identificando acuerdos y decisiones')},
  "Armando las tareas propuestas": {t('Armando las tareas propuestas')},
  "Revisando fechas y la próxima reunión": {t('Revisando fechas y la próxima reunión')},
  "Sigue trabajando; las transcripciones largas tardan más": {t('Sigue trabajando; las transcripciones largas tardan más')}
});
window.__t = window.__t || function (s) { var d = window.PA_I18N || {}; return d[s] !== undefined ? d[s] : s; };
</script>
<script n:syntax="off">
    (function () {
        var form = document.querySelector('form.pa-stack'), caja = document.getElementById('pa-ia-espera');
        if (!form || !caja) return;
        var pasos = [[0, __t('Leyendo la transcripción')], [8, __t('Identificando acuerdos y decisiones')], [18, __t('Armando las tareas propuestas')], [30, __t('Revisando fechas y la próxima reunión')], [45, __t('Sigue trabajando; las transcripciones largas tardan más')]];
        form.addEventListener('submit', function (e) {
            var b = e.submitter;
            if (!b || b.value !== 'analizar' || e.defaultPrevented) return;
            caja.hidden = false;
            var t0 = Date.now(), seg = document.getElementById('pa-ia-seg'), paso = document.getElementById('pa-ia-paso');
            setInterval(function () {
                var s = Math.floor((Date.now() - t0) / 1000);
                seg.textContent = s;
                for (var i = pasos.length - 1; i >= 0; i--) { if (s >= pasos[i][0]) { paso.textContent = pasos[i][1]; break; } }
            }, 500);
        });
        window.addEventListener('pageshow', function () { caja.hidden = true; });
    })();
</script>
{/if}

<form method="post" action="{$admin_url('reuniones/' . $reunion['id'] . '/borrar')}" onsubmit="return confirm('¿Eliminar esta reunión? Las tareas ya creadas se conservan.');" class="mt-4">
    <input type="hidden" name="_csrf_token" value="{$csrf_token}">
    <button type="submit" class="btn btn-sm btn-danger">Eliminar reunión</button>
</form>
{include '../_zonas.js.latte'}
{/block}
