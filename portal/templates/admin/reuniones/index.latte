{layout $plugin_ui_layout}

{block page_title}Reuniones{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/portal-admin.css">
<div class="page-header">
    <h1>Reuniones</h1>
    <a href="{$admin_url('reuniones/nuevo')}" class="btn btn-primary">Nueva reunión</a>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

{if empty($reuniones)}
    <div class="card">
        <p class="text-slate-500">Todavía no hay reuniones.</p>
    </div>
{else}
<div class="card">
    <table class="table">
        <thead>
            <tr>
                <th>Título</th>
                <th>Proyecto</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {foreach $reuniones as $r}
            <tr>
                <td><a href="{$admin_url('reuniones/' . $r['id'])}">{$r['titulo']}</a></td>
                <td>{$r['proyecto_nombre']}</td>
                <td>{$fmt->fechaLarga($r['fecha'])} {$fmt->hora($r['fecha'])}</td>
                <td>
                    {if !$r['publicada']}<span class="pa-chip">Oculta</span>{elseif $r['resumen_publicado'] && $r['resumen']}<span class="pa-chip ok">Resumen publicado</span>{elseif $r['resumen']}<span class="pa-chip warn">Resumen sin publicar</span>{else}<span class="pa-chip info">Visible</span>{/if}
                    {if $r['n_propuestas'] > 0}<span class="pa-chip brand">{$r['n_propuestas']} tareas por revisar</span>{/if}
                    {if $r['enlace_meet']}<span class="pa-chip">Meet</span>{/if}
                </td>
                <td>
                    <form method="post" action="{$admin_url('reuniones/' . $r['id'] . '/borrar')}" onsubmit="return confirm('¿Eliminar esta reunión?');">
                        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        {/foreach}
        </tbody>
    </table>
</div>
{/if}
