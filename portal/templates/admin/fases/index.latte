{layout $plugin_ui_layout}

{block page_title}Fases{/block}

{block content}
<div class="page-header">
    <h1>Fases</h1>
    <a href="{$admin_url('fases/nuevo')}" class="btn btn-primary">Nueva fase</a>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

{if empty($fases)}
    <div class="card"><p class="text-slate-500">Todavía no hay fases.</p></div>
{else}
<div class="card">
    <table class="table">
        <thead><tr><th>Fase</th><th>Proyecto</th><th>Orden</th><th>Inicio</th><th>Fin</th><th></th></tr></thead>
        <tbody>
        {foreach $fases as $f}
            <tr>
                <td><a href="{$admin_url('fases/' . $f['id'])}">{$f['nombre']}</a></td>
                <td>{$f['proyecto_nombre']}</td>
                <td>{$f['orden']}</td>
                <td>{$f['fecha_inicio'] ?? '—'}</td>
                <td>{$f['fecha_fin'] ?? '—'}</td>
                <td>
                    <form method="post" action="{$admin_url('fases/' . $f['id'] . '/borrar')}" onsubmit="return confirm('¿Eliminar esta fase?');">
                        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        {/foreach}
        </tbody>
    </table>
</div>
{/if}
