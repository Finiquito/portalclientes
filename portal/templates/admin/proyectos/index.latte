{layout $plugin_ui_layout}

{block page_title}Proyectos{/block}

{block content}
<div class="page-header">
    <h1>Proyectos</h1>
    <div class="pa-row"><a href="{$admin_url('plantillas')}" class="btn">Plantillas</a><a href="{$admin_url('proyectos/nuevo')}" class="btn btn-primary">Nuevo proyecto</a></div>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

{if empty($proyectos)}
    <div class="card">
        <p class="text-slate-500">Todavía no hay proyectos.</p>
    </div>
{else}
<div class="card">
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cliente</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {foreach $proyectos as $p}
            <tr>
                <td><a href="{$admin_url('proyectos/' . $p['id'])}">{$p['nombre']}</a></td>
                <td>{$p['cliente_nombre']}</td>
                <td>{$p['estado']}</td>
                <td>
                    <form method="post" action="{$admin_url('proyectos/' . $p['id'] . '/borrar')}" onsubmit="return confirm('¿Eliminar este proyecto?');">
                        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        {/foreach}
        </tbody>
    </table>
</div>
{/if}
