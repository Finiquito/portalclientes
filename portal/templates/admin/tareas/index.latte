{layout $plugin_ui_layout}

{block page_title}Tareas{/block}

{block content}
<link rel="stylesheet" href="/plugins/portal/assets/portal-admin.css">

<div class="page-header">
    <h1>Tareas</h1>
    <a href="{$admin_url('tareas/nuevo')}" class="btn btn-primary">Nueva tarea</a>
</div>

{if $flash_success}<div class="alert alert-success">{$flash_success}</div>{/if}
{if $flash_error}<div class="alert alert-error">{$flash_error}</div>{/if}

{if empty($tareas)}
    <div class="card">
        <p class="text-slate-500">Todavía no hay tareas.</p>
    </div>
{else}
<div class="card" style="overflow-x:auto">
    <table class="table">
        <thead>
            <tr>
                <th>Título</th>
                <th>Proyecto</th>
                <th>Le toca a</th>
                <th>Vence</th>
                <th>Estado</th>
                <th>Actividad</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {foreach $tareas as $t}
            {var $e = $fmt->estado($t['estado'])}
            {var $tono = ['muted' => '', 'ok' => 'ok', 'warn' => 'warn', 'danger' => 'danger', 'info' => 'info'][$e[1]] ?? ''}
            <tr {if $t['estado'] === 'entregada'}class="pa-new"{/if}>
                <td>
                    <a href="{$admin_url('tareas/' . $t['id'])}">{$t['titulo']}</a>
                    <div class="pa-muted">{$fmt->tipo($t['tipo'] ?? 'tarea')}{if (int) ($t['visible_cliente'] ?? 1) === 0} · interna{/if}</div>
                </td>
                <td>{$t['cliente_nombre']}<div class="pa-muted">{$t['proyecto_nombre']}</div></td>
                <td>
                    {if $t['responsable_tipo'] === 'cliente'}<span class="pa-chip brand">Cliente</span> {$t['contacto_nombre']}
                    {else}{$t['responsable_nombre'] ?? '—'}{/if}
                </td>
                <td>{$fmt->fecha($t['fecha_vencimiento'])}</td>
                <td><span class="pa-chip {$tono}">{$e[0]}</span></td>
                <td class="pa-muted">{$t['n_comentarios']} com. · {$t['n_archivos']} arch.</td>
                <td>
                    <form method="post" action="{$admin_url('tareas/' . $t['id'] . '/borrar')}" onsubmit="return confirm('¿Eliminar esta tarea con sus archivos y comentarios?');">
                        <input type="hidden" name="_csrf_token" value="{$csrf_token}">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </td>
            </tr>
        {/foreach}
        </tbody>
    </table>
</div>
{/if}
{/block}
