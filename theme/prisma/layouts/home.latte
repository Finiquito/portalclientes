{*
    Prisma · landing (usaprisma.com). Es el inicio del sitio y también el layout «Landing Prisma»
    que se puede elegir en cualquier página desde el editor (ver theme.json → layouts).
    Hallmark · macrostructure: Split Studio · nav: N9 edge-aligned · footer: Ft5 statement · enrichment: E5 hand-built SVG
*}
{layout 'base.latte'}
{var $accion = $accion ?? '/invitacion'}
{var $assets = '/themes/prisma/assets'}

{* Metadatos del landing: propios del tema, no los del SEO general del sitio (que
   pueden decir «Blog»). La imagen para compartir es assets/img/compartir.jpg (1200×630). *}
{var $sitio = 'https://usaprisma.com'}
{var $contacto = 'info@usaprisma.com'}
{var $autor = 'Richard González'}
{* Preguntas frecuentes: se muestran en la página y se repiten en los datos estructurados (FAQPage). *}
{var $preguntas = [
    ['¿Cuánto cuesta?', 'La beta es gratis y los cupos son limitados. Si más adelante Prisma tiene precio, te lo cuento antes de cobrarte nada.'],
    ['¿Qué me pides a cambio?', 'Que lo uses en tu trabajo real y me cuentes qué te sirve, qué falta y qué sobra. Eso es todo.'],
    ['¿Mis clientes tienen que crear una cuenta?', 'No. Entran con su correo y un código que les llega por correo; no hay contraseña que olvidar.'],
    ['¿Qué tan seguros están los datos de mis clientes?', 'Los datos de cada cliente están separados de los de los demás, todo viaja por HTTPS y las claves que guardas en Prisma van cifradas con AES-256.'],
    ['¿Tengo que instalar algo?', 'No. Prisma funciona desde el navegador, tanto para tu equipo como para tus clientes.'],
]}
{* Videos: los archivos van en public_html/videos/prisma-N.mp4; las portadas, en assets/img/video-N.jpg. *}
{var $videos = [
    [1, 'Lo que ve mi cliente', 'Su portal: qué le toca, qué está en revisión y cuándo es la próxima reunión.'],
    [2, 'Subir la grilla', 'La grilla de contenidos queda ordenada, pieza por pieza, en pocos minutos.'],
    [3, 'Sumar los diseños', 'Cada imagen cae en su pieza por el nombre del archivo.'],
    [4, 'Las reuniones', 'De la transcripción salen los acuerdos y las tareas.'],
    [5, 'Pedir archivos', 'Pido el logo una vez y el cliente lo sube en la misma tarea.'],
    [6, 'Los mensajes', 'Cada cosa tiene su conversación, en vez de cinco apps distintas.'],
    [7, 'Mi mañana', 'Una sola pantalla en vez de WhatsApp, correo y Drive.'],
]}
{block metas}
    {var $tituloComp = 'Prisma · Deja de perseguir a tus clientes por WhatsApp'}
    {var $descComp = 'Prisma es el portal donde tus clientes ven cómo avanza su proyecto, aprueban y te envían lo que falta. Para freelancers, estudios y agencias pequeñas. Beta gratis, cupos limitados.'}
    {var $url = (isset($seo) && $seo->canonical) ? $seo->canonical : $sitio . '/'}
    <title>{$tituloComp}</title>
    <meta name="description" content="{$descComp}">
    <link rel="canonical" href="{$url}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Prisma">
    <meta property="og:locale" content="es_LA">
    <meta property="og:title" content="{$tituloComp}">
    <meta property="og:description" content="{$descComp}">
    <meta property="og:url" content="{$url}">
    <meta property="og:image" content="{$sitio}/themes/prisma/assets/img/compartir.jpg?v=2">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Las cinco piezas de Prisma apiladas: portal, tareas, reuniones, revisiones y archivos">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{$tituloComp}">
    <meta name="twitter:description" content="{$descComp}">
    <meta name="twitter:image" content="{$sitio}/themes/prisma/assets/img/compartir.jpg?v=2">
    {* Datos estructurados (schema.org): qué es Prisma, para quién y dónde, en un formato que leen
       los buscadores y los asistentes de IA. Sólo lo que dice la página; sin precios ni cifras. *}
    <script type="application/ld+json">{json_encode([
        '@context' => 'https://schema.org',
        '@graph' => [
            ['@type' => 'Organization', '@id' => $sitio . '/#org', 'name' => 'Prisma', 'url' => $sitio . '/', 'logo' => $sitio . '/themes/prisma/assets/img/compartir.jpg'],
            ['@type' => 'WebSite', '@id' => $sitio . '/#web', 'url' => $sitio . '/', 'name' => 'Prisma', 'inLanguage' => 'es', 'publisher' => ['@id' => $sitio . '/#org']],
            ['@type' => 'SoftwareApplication', 'name' => 'Prisma', 'url' => $sitio . '/', 'applicationCategory' => 'BusinessApplication', 'applicationSubCategory' => 'Portal de clientes', 'operatingSystem' => 'Web',
             'inLanguage' => 'es', 'description' => $descComp, 'image' => $sitio . '/themes/prisma/assets/img/compartir.jpg',
             'audience' => ['@type' => 'BusinessAudience', 'audienceType' => 'Freelancers, estudios de diseño y agencias pequeñas de publicidad o marketing (equipos de 1 a 15 personas)'],
             'areaServed' => 'Latinoamérica', 'publisher' => ['@id' => $sitio . '/#org'],
             'offers' => ['@type' => 'Offer', 'price' => '0', 'priceCurrency' => 'CLP', 'description' => 'Beta gratuita con cupos limitados'],
             'featureList' => ['Portal para el cliente con su logo y su color', 'Ingreso del cliente con su correo y un código, sin contraseña', 'Tareas con archivos que sube el cliente', 'Aprobación de contenidos pieza por pieza', 'Reuniones con resumen, acuerdos y tareas a partir de las notas', 'Panel del equipo con cuentas asignadas y avisos']],
            ['@type' => 'FAQPage', 'mainEntity' => array_map(fn($p) => ['@type' => 'Question', 'name' => $p[0], 'acceptedAnswer' => ['@type' => 'Answer', 'text' => $p[1]]], $preguntas)],
        ],
    ], \JSON_UNESCAPED_UNICODE | \JSON_UNESCAPED_SLASHES | \JSON_HEX_TAG)|noescape}</script>
{/block}

{block content}


    {* ---- Portada: texto a la izquierda, el prisma desarmándose a la derecha ---- *}
    <section class="portada">
        <div class="contenedor portada-grilla">
            <div class="portada-texto">
                <p class="sello">Beta gratis · Cupos limitados</p>
                <h1>Deja de perseguir a tus clientes por WhatsApp.</h1>
                <p class="bajada">Prisma es el portal donde tus clientes ven cómo avanza su proyecto, aprueban y te envían lo que falta. Tareas, reuniones, revisiones y archivos, en un solo lugar para tu estudio, tu agencia pequeña o tu trabajo independiente.</p>

                <form class="form-corto" action="#invitacion" method="get" data-continuar novalidate>
                    <label for="correo-portada" class="solo-lector">Tu correo</label>
                    <input id="correo-portada" class="campo" type="email" name="email" placeholder="tu@estudio.com" autocomplete="email" inputmode="email" required>
                    <button type="submit" class="boton">Probar la beta gratis</button>
                    <p class="form-estado" data-estado role="status" aria-live="polite"></p>
                </form>
                <p class="nota">Luego te pido tu nombre y el tamaño de tu equipo, y listo. <a href="#videos">¿Quieres verlo antes?</a></p>
            </div>

            <figure class="portada-figura">
                <div class="lamina lamina-bloques">{include '../partials/hero-bloques.latte'}</div>
            </figure>
        </div>

        <ul class="contenedor franja" aria-label="En corto">
            <li>Para equipos de 1 a 15 personas</li>
            <li>Tu cliente entra con su correo, sin contraseña</li>
            <li>En español, para Latinoamérica</li>
        </ul>
    </section>

    {* ---- Videos: el producto funcionando ---- *}
    <section class="videos" id="videos" aria-labelledby="t-videos">
        <div class="contenedor videos-grilla">
            <div class="visor" data-visor>
                <video controls playsinline preload="none" width="1080" height="1350" poster="{$assets}/img/video-1.jpg" src="/videos/prisma-1.mp4" data-id="1"></video>
            </div>
            <div class="videos-texto">
                <h2 id="t-videos">Míralo funcionando.</h2>
                <p>Siete recorridos cortos del panel real, con datos de ejemplo. Parte por el primero y sigue por el que más se parezca a tu semana.</p>
                <ol class="lista-videos">
                    {foreach $videos as [$n, $titulo, $desc]}
                    <li>
                        <a href="/videos/prisma-{$n}.mp4" data-video="{$n}" data-poster="{$assets}/img/video-{$n}.jpg" {if $n === 1}aria-current="true"{/if}>
                            <span class="lista-videos-n">{$n}</span>
                            <strong>{$titulo}</strong>
                            <span class="lista-videos-d">{$desc}</span>
                        </a>
                    </li>
                    {/foreach}
                </ol>
            </div>
        </div>
    </section>

    {* ---- Las piezas ---- *}
    <section class="piezas" id="como-funciona" aria-labelledby="t-piezas">
        <div class="contenedor piezas-grilla">
            <div class="piezas-texto">
                <h2 id="t-piezas">Un proyecto, cinco piezas.</h2>
                <p>Lo que hoy vive mezclado en el chat, en Prisma tiene su lugar. Cada pieza hace una sola cosa, y el cliente sabe siempre dónde mirar.</p>
                {include '../partials/despiece-leyenda.latte'}
            </div>
            <figure class="piezas-figura">
                {include '../partials/despiece-diagrama.latte'}
            </figure>
        </div>
    </section>

    {* ---- Antes / con Prisma ---- *}
    <section class="cambio" aria-labelledby="t-cambio">
        <div class="contenedor">
            <h2 id="t-cambio">Lo que cambia el lunes.</h2>
            <table class="tabla-cambio">
                <thead>
                    <tr><th scope="col">Hoy</th><th scope="col">Con Prisma</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>«¿Me envías el logo en alta resolución?», tres veces, por WhatsApp.</td>
                        <td>Una tarea «Pedir archivos». El cliente los sube ahí y quedan guardados con la tarea.</td>
                    </tr>
                    <tr>
                        <td>La aprobación del calendario de publicaciones, perdida en un hilo de correos.</td>
                        <td>El cliente aprueba o pide cambios post por post, y te llega un solo aviso con todo.</td>
                    </tr>
                    <tr>
                        <td>La reunión terminó y nadie anotó qué quedó para quién.</td>
                        <td>Pegas tus notas o la transcripción: sale el resumen, los acuerdos y la lista de tareas.</td>
                    </tr>
                    <tr>
                        <td>«¿Cómo va lo mío?»</td>
                        <td>El cliente lo ve solo: qué está listo, qué le toca y qué viene.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    {* ---- El producto, de verdad ---- *}
    <section class="producto" aria-labelledby="t-producto">
        <div class="contenedor">
            <h2 id="t-producto" class="solo-lector">Cómo se ve</h2>

            <div class="diptico">
                <figure class="diptico-figura">
                    <img src="{$assets}/img/portal-cliente.jpg" width="1920" height="1230" alt="Portal de una panadería: saludo a Josefa, una tarea pendiente para aprobar precios, la próxima reunión y el avance del proyecto por fases." loading="lazy" decoding="async">
                    <figcaption>Portal de un cliente · datos de ejemplo</figcaption>
                </figure>
                <div class="diptico-texto">
                    <h3>Lo que ve tu cliente.</h3>
                    <p>Su logo, su color y solo lo suyo: qué le toca, qué está en revisión y cuándo es la próxima reunión. Entra con su correo y un código; no hay contraseña que olvidar.</p>
                </div>
            </div>

            <div class="diptico diptico-invertido">
                <div class="diptico-texto">
                    <h3>Lo que ves tú.</h3>
                    <p>Una bandeja con lo que respondió cada cliente, lo vencido y lo que viene esta semana. Cada persona de tu equipo ve las cuentas que tiene asignadas, y los avisos le llegan a quien corresponde.</p>
                </div>
                <figure class="diptico-figura">
                    <img src="{$assets}/img/panel-equipo.jpg" width="1920" height="1230" alt="Panel del equipo: respuestas de los clientes por revisar, tareas asignadas, próximas reuniones y novedades." loading="lazy" decoding="async">
                    <figcaption>Panel del equipo · datos de ejemplo</figcaption>
                </figure>
            </div>
        </div>
    </section>

    {* ---- Para quién ---- *}
    <section class="para-quien" aria-labelledby="t-quien">
        <div class="contenedor quien-grilla">
            <h2 id="t-quien">Para equipos de 1 a 15 personas.</h2>
            <div class="quien-texto">
                <p>Freelancers, profesionales independientes, estudios de diseño y agencias pequeñas de publicidad o marketing. Si hoy llevas a tus clientes entre WhatsApp, Drive y correo, Prisma es para ti.</p>
                <p>Si tienes cuarenta cuentas y un área de TI, probablemente no.</p>
            </div>
        </div>
    </section>

    {* ---- Quién está detrás. La foto es opcional: si existe assets/img/autor.jpg, el JS la muestra. ---- *}
    <section class="autor" aria-labelledby="t-autor">
        <div class="contenedor autor-grilla">
            <h2 id="t-autor">Quién está detrás.</h2>
            <figure class="autor-foto" data-foto hidden>
                <img data-src="{$assets}/img/autor.jpg" width="640" height="640" alt="{$autor}" decoding="async">
            </figure>
            <div class="autor-texto">
                <p>Soy Richard, diseñador y desarrollador freelancer en Chile, con 15 años trabajando en frontend. Llevaba a mis clientes entre WhatsApp, Drive y correo, y perdía horas persiguiendo logos, aprobaciones y respuestas.</p>
                <p>Armé Prisma para mi propio trabajo y hoy lo uso en mi día a día. Lo estoy abriendo en beta gratis a cambio de tus comentarios: qué te sirve, qué falta y qué sobra.</p>
                <p class="autor-firma"><strong>{$autor}</strong> · Escríbeme a <a href="mailto:{$contacto}">{$contacto}</a></p>
            </div>
        </div>
    </section>

    {* ---- Preguntas frecuentes ---- *}
    <section class="preguntas" id="preguntas" aria-labelledby="t-preguntas">
        <div class="contenedor faq-grilla">
            <h2 id="t-preguntas">Preguntas frecuentes.</h2>
            <div class="faq-lista">
                {foreach $preguntas as [$pregunta, $respuesta]}
                <details class="faq-item">
                    <summary>{$pregunta}</summary>
                    <p>{$respuesta}</p>
                </details>
                {/foreach}
            </div>
        </div>
    </section>

    {* ---- Invitación ---- *}
    <section class="invitacion" id="invitacion" aria-labelledby="t-invitacion">
        <div class="contenedor invitacion-grilla">
            <div class="invitacion-texto">
                <h2 id="t-invitacion">Prueba la beta gratis.</h2>
                <p>Estoy abriendo Prisma de a poco, con freelancers, estudios y agencias de Latinoamérica, y los cupos son limitados. Déjame tus datos y te escribo cuando tenga lugar para ti.</p>
            </div>

            <form class="form-largo" action="{$accion}" method="post" data-invitacion novalidate>
                <input type="hidden" name="origen" value="formulario" data-origen>
                <input type="hidden" name="t" value="" data-t>
                <div class="trampa" aria-hidden="true"><label>Sitio web <input type="text" name="sitio_web" tabindex="-1" autocomplete="off"></label></div>

                <div class="fila-2">
                    <div class="campo-grupo">
                        <label for="f-nombre">Nombre</label>
                        <input id="f-nombre" class="campo" type="text" name="nombre" autocomplete="given-name" maxlength="80" required>
                    </div>
                    <div class="campo-grupo">
                        <label for="f-correo">Correo <span class="campo-listo" data-listo hidden>✓ Ya lo tenemos</span></label>
                        <input id="f-correo" class="campo" type="email" name="email" autocomplete="email" inputmode="email" required>
                    </div>
                </div>

                <fieldset class="campo-grupo">
                    <legend>¿Cuántos son en tu equipo?</legend>
                    <div class="segmentos">
                        <label><input type="radio" name="tamano" value="1" required><span>Trabajo solo</span></label>
                        <label><input type="radio" name="tamano" value="2-5"><span>2 a 5</span></label>
                        <label><input type="radio" name="tamano" value="6-15"><span>6 a 15</span></label>
                        <label><input type="radio" name="tamano" value="+15"><span>Más de 15</span></label>
                    </div>
                </fieldset>

                <div class="campo-grupo">
                    <label for="f-rubro">¿A qué se dedican? <span class="opcional">opcional</span></label>
                    <select id="f-rubro" class="campo" name="rubro">
                        <option value="">Elige una opción</option>
                        <option>Diseño gráfico</option>
                        <option>Publicidad</option>
                        <option>Marketing digital y redes</option>
                        <option>Desarrollo web</option>
                        <option>Audiovisual</option>
                        <option>Otro</option>
                    </select>
                </div>

                <button type="submit" class="boton boton-grande" data-enviando="Enviando…">Probar la beta gratis</button>
                <p class="form-estado" data-estado role="status" aria-live="polite"></p>
                <p class="nota">Uso tu correo solo para esto. Te puedes dar de baja con un clic.</p>
            </form>
        </div>
    </section>
{/block}
